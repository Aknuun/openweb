  -u, --user <name>         Linux user that runs the service (default: root)
  -U, --username <name>     Web login username (default: opencode)
      --password <value>    Web login password (prompted if omitted)
      --web <v1|v2>         Web engine: v1.19.4 + custom UI, or v2 native
                            (v2 adds a quick toolbar and shares sessions with the CLI)
      --original            Serve the unmodified OpenCode web UI
      --modified            Serve the modified v1 UI (requires nginx)
      --features <list>     Comma-separated v1 features (use "all" or "none")
