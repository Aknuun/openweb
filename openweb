require_root() {
  [[ $EUID -eq 0 ]] || die "run as root (sudo)"
}

is_interactive() {
  [[ -r /dev/tty ]] && (( ASSUME_YES == 0 ))
}

port_valid() {
  [[ $1 =~ ^[0-9]+$ ]] || return 1
  (( 10#$1 >= 1 && 10#$1 <= 65535 ))
}

host_valid() {
  [[ $1 =~ ^[A-Za-z0-9._:-]+$ ]]
}

auth_user_valid() {
  [[ $1 =~ ^[A-Za-z0-9._-]+$ ]]
}

validate_port() {
  port_valid "$LISTEN_PORT" || die "invalid port: $LISTEN_PORT (expected 1-65535)"
}

validate_settings() {
  validate_port
  host_valid "$LISTEN_HOST" || die "invalid listen address: $LISTEN_HOST"
  auth_user_valid "$AUTH_USER" || die "invalid username: $AUTH_USER"
  [[ $UI_MODE == original || $UI_MODE == modified ]] || die "invalid UI mode: ${UI_MODE:-<empty>} (original|modified)"
  case ${WEB_API:-v1} in
    v1 | v2) ;;
    *) die "invalid web API: ${WEB_API:-<empty>} (v1|v2)" ;;
  esac
  if web_v2 && [[ $UI_MODE == modified ]]; then
    die "the v2 web API uses the native UI; custom v1 features are not supported. Use --original or --web v1"
  fi
  id "$SERVICE_USER" >/dev/null 2>&1 || die "user does not exist: $SERVICE_USER"

  SERVICE_GROUP=$(id -gn "$SERVICE_USER")
  SERVICE_HOME=$(getent passwd "$SERVICE_USER" | cut -d: -f6)
  [[ -n $SERVICE_HOME && -d $SERVICE_HOME ]] || die "cannot determine home directory for $SERVICE_USER"
  [[ $SERVICE_HOME != *[[:space:]]* ]] || die "home directory must not contain whitespace: $SERVICE_HOME"

  if [[ -n $UPSTREAM_PORT ]]; then
    port_valid "$UPSTREAM_PORT" || die "invalid upstream port: $UPSTREAM_PORT"
    [[ $UPSTREAM_PORT != "$LISTEN_PORT" ]] || die "upstream port and public port must differ"
  fi

  case ${TLS_MODE:-http} in
    http | letsencrypt | custom) ;;
    *) die "invalid TLS mode: ${TLS_MODE:-<empty>} (http|letsencrypt|custom)" ;;
  esac

  if tls_enabled; then
    [[ -n $DOMAIN ]] || die "a domain is required when TLS is enabled"
    domain_valid "$DOMAIN" || die "invalid domain: $DOMAIN"
    port_valid "$HTTPS_PORT" || die "invalid HTTPS port: $HTTPS_PORT"
    [[ $HTTPS_PORT != "$LISTEN_PORT" ]] || die "HTTPS port and plain HTTP port must differ"
    [[ $LISTEN_PORT != 80 ]] || die "plain HTTP port 80 is reserved for ACME/redirect; choose another port"
    [[ $HTTPS_PORT != 80 ]] || die "HTTPS port cannot be 80"
    if [[ $TLS_MODE == custom ]]; then
      [[ -n $TLS_CERT && -f $TLS_CERT ]] || die "TLS certificate not found: ${TLS_CERT:-<empty>}"
      [[ -n $TLS_KEY && -f $TLS_KEY ]] || die "TLS private key not found: ${TLS_KEY:-<empty>}"
    fi
  fi
}

confirm() {
  (( ASSUME_YES == 1 )) && return 0
  [[ -r /dev/tty ]] || return 1

  local answer
  printf '%s?%s %s [y/N] ' "$C_YELLOW" "$C_RESET" "$1" >/dev/tty
  IFS= read -r answer < /dev/tty || return 1
  [[ $answer =~ ^[Yy]$ ]]
}

read_value() {
  local label=$1 default=$2 answer
  printf '%s%s%s [%s]: ' "$C_BOLD" "$label" "$C_RESET" "$default" >/dev/tty
  IFS= read -r answer < /dev/tty || die "failed to read input"
  REPLY_VALUE=${answer:-$default}
}

prompt_password() {
  if [[ -n $PASSWORD ]]; then
    [[ $PASSWORD != *$'\n'* ]] || die "password must not contain newlines"
    (( ${#PASSWORD} >= 8 )) || die "password must be at least 8 characters"
    return 0
  fi

  [[ -r /dev/tty ]] || die "no terminal for the password prompt; use --password or OPENWEB_PASSWORD"

  local first second
  while true; do
    printf '%sChoose a password for %s (min 8 characters):%s ' "$C_BOLD" "$AUTH_USER" "$C_RESET" >/dev/tty
    IFS= read -rs first < /dev/tty || die "failed to read password"
    printf '\n' >/dev/tty

    if (( ${#first} < 8 )); then
      warn "password must be at least 8 characters"
      continue
    fi

    printf '%sConfirm password:%s ' "$C_BOLD" "$C_RESET" >/dev/tty
    IFS= read -rs second < /dev/tty || die "failed to read password"
    printf '\n' >/dev/tty

    if [[ $first != "$second" ]]; then
      warn "passwords do not match"
      continue
    fi

    PASSWORD=$first
    return 0
  done
}

feature_known() {
  local wanted=$1 key
  for key in "${FEATURE_KEYS[@]}"; do
    [[ $key == "$wanted" ]] && return 0
  done
  return 1
}

feature_is_on() {
  [[ ",${FEATURES// /,}," == *",$1,"* ]]
}

feature_add() {
  feature_is_on "$1" && return 0
  FEATURES="${FEATURES:+${FEATURES},}$1"
}

features_normalized() {
  local out="" key
  for key in "${FEATURE_KEYS[@]}"; do
    if feature_is_on "$key"; then
      out="${out:+${out},}${key}"
    fi
  done
  printf '%s' "$out"
}

set_features() {
  local raw=$1 token key
  local -a tokens=()
  FEATURES=""
  IFS=' ,' read -r -a tokens <<< "$raw"
  for token in "${tokens[@]}"; do
    token=${token,,}
    case $token in
      all)
        for key in "${FEATURE_KEYS[@]}"; do
          feature_add "$key"
        done
        ;;
      none) ;;
      *)
        feature_known "$token" || die "unknown feature: ${token} (known: ${FEATURE_KEYS[*]})"
        feature_add "$token"
        ;;
    esac
  done
  FEATURES=$(features_normalized)
  FEATURES_SET=1
}

features_remove() {
  local target=$1 key out=""
  local -a keys=()
  IFS=',' read -r -a keys <<< "$FEATURES"
  for key in "${keys[@]}"; do
    [[ $key == "$target" ]] || out="${out:+${out},}${key}"
  done
  FEATURES=$out
  FEATURES_SET=1
}

feature_by_number() {
  local number=$1
  [[ $number =~ ^[0-9]+$ ]] || return 1
  (( number >= 1 && number <= ${#FEATURE_KEYS[@]} )) || return 1
  printf '%s' "${FEATURE_KEYS[$((number - 1))]}"
}

features_menu() {
  local -A on=()
  local original=$FEATURES
  local key answer token index state number
  local -a defaults=()
  IFS=',' read -r -a defaults <<< "$FEATURES"
  for key in "${defaults[@]}"; do
    if feature_known "$key"; then
      on[$key]=1
    fi
  done

  while true; do
    printf '\n%s================= Feature manager =================%s\n' "$C_CYAN" "$C_RESET" >/dev/tty
    printf '%s UI mode:%s %s\n\n' "$C_BOLD" "$C_RESET" "$UI_MODE" >/dev/tty
    for index in "${!FEATURE_KEYS[@]}"; do
      key=${FEATURE_KEYS[$index]}
      if [[ ${on[$key]:-0} == 1 ]]; then
        state="${C_GREEN}x${C_RESET}"
      else
        state="${C_DIM} ${C_RESET}"
      fi
      printf '  %s%2d)%s [%s] %-42s %s\n' "$C_BOLD" "$((index + 1))" "$C_RESET" "$state" "${FEATURE_LABELS[$index]}" "$C_DIM" >/dev/tty
    done
    printf '\n  %s11)%s Enable all\n' "$C_BOLD" "$C_RESET" >/dev/tty
    printf '  %s12)%s Disable all\n' "$C_BOLD" "$C_RESET" >/dev/tty
    printf '  %s13)%s Reset to defaults\n' "$C_BOLD" "$C_RESET" >/dev/tty
    printf '  %s14)%s Apply and exit\n' "$C_BOLD" "$C_RESET" >/dev/tty
    printf '  %s 0)%s Cancel\n' "$C_BOLD" "$C_RESET" >/dev/tty
    printf '\nSelect one or more numbers (for example 1 3 5) [14]: ' >/dev/tty
    IFS= read -r answer < /dev/tty || die "failed to read features"

    case $answer in
      '' | 14 | s | save | apply)
        break
        ;;
      0 | q | cancel)
        FEATURES=$original
        return 1
        ;;
      11 | a | all)
        for key in "${FEATURE_KEYS[@]}"; do on[$key]=1; done
        ;;
      12 | n | none)
        for key in "${FEATURE_KEYS[@]}"; do on[$key]=0; done
        ;;
      13 | r | reset)
        for key in "${FEATURE_KEYS[@]}"; do on[$key]=1; done
        ;;
      *)
        for token in $answer; do
          case $token in
            11 | a | all)
              for key in "${FEATURE_KEYS[@]}"; do on[$key]=1; done
              ;;
            12 | n | none)
              for key in "${FEATURE_KEYS[@]}"; do on[$key]=0; done
              ;;
            13 | r | reset)
              for key in "${FEATURE_KEYS[@]}"; do on[$key]=1; done
              ;;
            *)
              if number=$(feature_by_number "$token"); then
                if [[ ${on[$number]:-0} == 1 ]]; then on[$number]=0; else on[$number]=1; fi
              else
                warn "invalid selection: ${token}"
              fi
              ;;
          esac
        done
        ;;
    esac
  done

  FEATURES=""
  for key in "${FEATURE_KEYS[@]}"; do
    if [[ ${on[$key]:-0} == 1 ]]; then
      feature_add "$key"
    fi
  done
  FEATURES_SET=1
  return 0
}


features_list() {
  local index key state
  printf '%sUI mode%s : %s\n' "$C_BOLD" "$C_RESET" "$UI_MODE"
  for index in "${!FEATURE_KEYS[@]}"; do
    key=${FEATURE_KEYS[$index]}
    if feature_is_on "$key"; then state="${C_GREEN}on${C_RESET}"; else state="${C_DIM}off${C_RESET}"; fi
    printf '  %-10s %-4b %s\n' "$key" "$state" "${FEATURE_LABELS[$index]}"
  done
}

find_opencode() {
  local candidate
  for candidate in "$PINNED_OPENCODE" "${SERVICE_HOME}/.opencode/bin/opencode" /usr/local/bin/opencode /usr/bin/opencode; do
    if [[ -x $candidate ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  candidate=$(command -v opencode 2>/dev/null || true)
  if [[ -n $candidate && -x $candidate ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  return 1
}

find_system_opencode() {
  local candidate
  for candidate in /usr/local/bin/opencode /usr/bin/opencode; do
    if [[ -x $candidate && $candidate != "$PINNED_OPENCODE" && $candidate != "$V2_OPENCODE" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  candidate=$(command -v opencode 2>/dev/null || true)
  if [[ -n $candidate && -x $candidate && $candidate != "$PINNED_OPENCODE" && $candidate != "$V2_OPENCODE" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  return 1
}

opencode_major() {
  local bin=$1 version
  version=$("$bin" --version 2>/dev/null | awk 'match($0, /[0-9]+/) { print substr($0, RSTART, RLENGTH); exit }')
  printf '%s' "${version:-1}"
}

install_pinned_opencode() {
  need curl
  info "installing OpenCode v${COMPAT_OPENCODE_VERSION} for the managed service"

  mkdir -p "$RUNNER_DIR"
  local home="${RUNNER_DIR}/opencode-home" tmp installed
  rm -rf "$home"
  mkdir -p "$home"
  tmp=$(mktemp)

  if ! curl -fsSL --retry 3 https://opencode.ai/install -o "$tmp"; then
    rm -f "$tmp"
    rm -rf "$home"
    die "failed to download the OpenCode installer"
  fi

  if ! HOME="$home" bash "$tmp" --version "$COMPAT_OPENCODE_VERSION" --no-modify-path >&2; then
    rm -f "$tmp"
    rm -rf "$home"
    die "OpenCode v${COMPAT_OPENCODE_VERSION} installation failed"
  fi
  rm -f "$tmp"

  installed="${home}/.opencode/bin/opencode"
  [[ -x $installed ]] || die "OpenCode v${COMPAT_OPENCODE_VERSION} was installed but the binary was not found"
  install -m 0755 "$installed" "$PINNED_OPENCODE"
  rm -rf "$home"
  OPENCODE_BIN=$PINNED_OPENCODE
}

install_v2_opencode() {
  need curl
  info "installing OpenCode v2 for the managed web service"

  mkdir -p "$RUNNER_DIR"
  local home="${RUNNER_DIR}/opencode-v2-home" tmp installed major
  rm -rf "$home"
  mkdir -p "$home"
  tmp=$(mktemp)

  if ! curl -fsSL --retry 3 https://opencode.ai/install -o "$tmp"; then
    rm -f "$tmp"
    rm -rf "$home"
    die "failed to download the OpenCode installer"
  fi

  if ! HOME="$home" bash "$tmp" --no-modify-path >&2; then
    rm -f "$tmp"
    rm -rf "$home"
    die "OpenCode v2 installation failed"
  fi
  rm -f "$tmp"

  installed="${home}/.opencode/bin/opencode"
  [[ -x $installed ]] || die "OpenCode was installed but the binary was not found"
  major=$(opencode_major "$installed")
  if ! [[ $major =~ ^[0-9]+$ ]] || (( major < 2 )); then
    rm -rf "$home"
    die "the OpenCode installer did not provide v2; use --web v1 for the pinned v1 web UI"
  fi
  install -m 0755 "$installed" "$V2_OPENCODE"
  rm -rf "$home"
  OPENCODE_BIN=$V2_OPENCODE
}

ensure_compatible_opencode() {
  local major

  if web_v2; then
    OPENCODE_BIN=$(find_system_opencode || true)
    if [[ -n $OPENCODE_BIN ]]; then
      major=$(opencode_major "$OPENCODE_BIN")
    else
      major=0
    fi

    if [[ -z $OPENCODE_BIN ]] || ! [[ $major =~ ^[0-9]+$ ]] || (( major < 2 )); then
      if [[ -x $V2_OPENCODE ]]; then
        OPENCODE_BIN=$V2_OPENCODE
      else
        install_v2_opencode
        return 0
      fi
    fi

    major=$(opencode_major "$OPENCODE_BIN")
    if ! [[ $major =~ ^[0-9]+$ ]] || (( major < 2 )); then
      die "OpenCode v2 is required for --web v2"
    fi
    return 0
  fi

  OPENCODE_BIN=$(find_opencode || true)

  if [[ $UI_MODE == modified ]]; then
    if [[ -x $PINNED_OPENCODE ]]; then
      OPENCODE_BIN=$PINNED_OPENCODE
      return 0
    fi
    install_pinned_opencode
    return 0
  fi

  if [[ -z $OPENCODE_BIN ]]; then
    install_pinned_opencode
    return 0
  fi

  major=$(opencode_major "$OPENCODE_BIN")
  if [[ $major =~ ^[0-9]+$ ]] && (( major >= 2 )); then
    info "OpenCode v${major} uses a different web server; installing v${COMPAT_OPENCODE_VERSION} for the managed service"
    install_pinned_opencode
  fi
  return 0
}

opencode_version() {
  "$1" --version 2>/dev/null | awk '{ print $NF }' | sed 's/^v//'
}

latest_opencode_version() {
  npm view @opencode/cli version --silent 2>/dev/null | tail -n1
}

ensure_node_runtime() {
  local major
  major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
  if (( major >= 18 )) && have npm; then
    return 0
  fi

  info "installing Node.js 22 (found: $(node -v 2>/dev/null || echo none)); @opencode/cli needs Node 18+"
  if have apt-get; then
    # The distro npm package pins an old Node, and libnode-dev conflicts with
    # the NodeSource package's headers.
    apt-get remove -y -qq npm libnode-dev >&2 || true
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - >&2 \
      || die "could not add the NodeSource repository"
    apt-get install -y -qq nodejs >&2 || die "could not install Node.js 22"
  elif have dnf; then
    dnf install -y nodejs npm >&2 || die "could not install Node.js"
  elif have yum; then
    yum install -y nodejs npm >&2 || die "could not install Node.js"
  fi

  major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
  (( major >= 18 )) || die "Node.js 18 or newer is required (found: $(node -v 2>/dev/null || echo none))"
  have npm || die "missing dependency: npm"
}

ensure_host_prereqs() {
  export DEBIAN_FRONTEND=noninteractive
  progress 5 "installing system prerequisites"

  if have apt-get; then
    apt-get update -qq >&2 || warn "apt-get update failed; continuing"
    apt-get install -y -qq -o Dpkg::Options::=--force-confold curl ca-certificates tar gnupg >&2 \
      || warn "could not install curl/gnupg; continuing with existing tools"
  elif have dnf; then
    dnf install -y curl ca-certificates tar >&2 || warn "could not install curl; continuing with existing tools"
  elif have yum; then
    yum install -y curl ca-certificates tar >&2 || warn "could not install curl; continuing with existing tools"
  fi

  have curl || die "missing dependency: curl"
  ensure_node_runtime
}

ensure_latest_opencode() {
  local latest bin current prefix=/usr/local target name backup
  local -a moved=()

  latest=$(latest_opencode_version || true)
  bin=$(find_system_opencode || true)

  if [[ -n $bin ]]; then
    current=$(opencode_version "$bin")
    if [[ -n $latest && $current == "$latest" ]]; then
      info "OpenCode v${current} is already installed"
      return 0
    fi
    if [[ -z $latest ]]; then
      warn "could not check for an OpenCode update; keeping v${current:-unknown}"
      return 0
    fi
  elif [[ -z $latest ]]; then
    die "could not determine the latest OpenCode version; check network access"
  fi

  info "installing OpenCode v${latest} (latest)"

  # Install into /usr/local even when npm's prefix is /usr (NodeSource), and
  # move any old bin aside: npm refuses to overwrite bins it does not own.
  for name in opencode opencode2; do
    target="${prefix}/bin/${name}"
    if [[ -e $target || -L $target ]]; then
      backup="${target}.openweb-backup"
      rm -f "$backup"
      mv -f "$target" "$backup" || die "could not replace ${target}"
      moved+=("$target")
    fi
  done

  if ! npm install -g --prefix "$prefix" --no-fund --no-audit "@opencode/cli@${latest}" >&2; then
    for target in "${moved[@]}"; do
      mv -f "${target}.openweb-backup" "$target"
    done
    die "failed to install OpenCode v${latest}"
  fi
  for target in "${moved[@]}"; do
    rm -f "${target}.openweb-backup"
  done
  hash -r 2>/dev/null || true
}

port_free() {
  local port=$1
  have ss || return 0
  ! ss -ltn 2>/dev/null | awk 'NR > 1 { print $4 }' | grep -qE "[:.]${port}$"
}

find_free_port() {
  local port=$1
  have ss || { printf '%s' "$port"; return 0; }
  while (( port <= 65535 )); do
    if port_free "$port"; then
      printf '%s' "$port"
      return 0
    fi
    port=$((port + 1))
  done
  die "no free port found"
}

random_free_port() {
  local attempt port skip
  for ((attempt = 0; attempt < 64; attempt++)); do
    port=$(( (RANDOM * 32768 + RANDOM) % 40001 + 20000 ))
    port_free "$port" || continue
    for skip in "$@"; do
      [[ $port == "$skip" ]] && continue 2
    done
    printf '%s' "$port"
    return 0
  done
  die "no free random port found"
}

check_port_free() {
  local attempt
  for ((attempt = 1; attempt <= 20; attempt++)); do
    if port_free "$LISTEN_PORT"; then
      return 0
    fi
    sleep 0.25
  done
  die "port ${LISTEN_PORT} is already in use"
}

port_owner() {
  local port=$1
  have ss || return 0
  ss -ltnp 2>/dev/null | awk -v p=":${port}$" 'NR > 1 && $4 ~ p { print $6; exit }' \
    | sed -n 's/.*users:(("\([^"]*\)".*/\1/p'
}

nginx_config_uses_port() {
  local port=$1 file
  local -a files=(/etc/nginx/nginx.conf)
  for file in /etc/nginx/conf.d/*.conf /etc/nginx/sites-enabled/*; do
    [[ -f $file ]] && files+=("$file")
  done
  for file in "${files[@]}"; do
    if sed 's/#.*//' "$file" 2>/dev/null \
      | grep -Eq "listen[[:space:]]+([^;]*[.:])?${port}([[:space:];]|\$)"; then
      return 0
    fi
  done
  return 1
}

port_owned_by_nginx() {
  systemctl is-active --quiet nginx || return 1
  nginx_config_uses_port "$1"
}

port_available_for_nginx() {
  port_free "$1" || port_owned_by_nginx "$1"
}

wait_port_free() {
  local port=$1 attempt
  have ss || return 0
  for ((attempt = 1; attempt <= 20; attempt++)); do
    if port_free "$port"; then
      return 0
    fi
    sleep 0.25
  done
  return 1
}

find_free_port_excluding() {
  local port=$1 skip bad
  shift
  have ss || { printf '%s' "$port"; return 0; }
  while (( port <= 65535 )); do
    bad=0
    for skip in "$@"; do
      if [[ -n $skip && $port == "$skip" ]]; then
        bad=1
      fi
    done
    if (( ! bad )) && port_free "$port"; then
      printf '%s' "$port"
      return 0
    fi
    port=$((port + 1))
  done
  die "no free port found"
}

select_listen_port() {
  if tls_enabled && [[ $LISTEN_PORT == 80 ]]; then
    warn "port 80 is reserved for the ACME challenge; moving the plain HTTP front to 5002"
    LISTEN_PORT=5002
  fi
  if wait_port_free "$LISTEN_PORT"; then
    return 0
  fi
  if port_owned_by_nginx "$LISTEN_PORT" && [[ -f $NGINX_CONF ]] && [[ $(config_value LISTEN_PORT) == "$LISTEN_PORT" ]]; then
    return 0
  fi
  local new
  new=$(find_free_port_excluding "$((LISTEN_PORT + 1))" 80 443 "$HTTPS_PORT")
  warn "port ${LISTEN_PORT} is in use; using ${new} for the plain HTTP front"
  LISTEN_PORT=$new
}

select_https_port() {
  if [[ -z $HTTPS_PORT || $HTTPS_PORT == 80 || $HTTPS_PORT == "$LISTEN_PORT" ]]; then
    [[ -z $HTTPS_PORT ]] || warn "HTTPS port ${HTTPS_PORT} conflicts with another listener; selecting a free port"
    HTTPS_PORT=$(random_free_port 80 "$LISTEN_PORT" "$UPSTREAM_PORT")
  fi
  if port_available_for_nginx "$HTTPS_PORT"; then
    return 0
  fi
  local new
  new=$(random_free_port 80 "$LISTEN_PORT" "$UPSTREAM_PORT" "$HTTPS_PORT")
  warn "HTTPS port ${HTTPS_PORT} is in use; using ${new} instead"
  HTTPS_PORT=$new
}

select_upstream_port() {
  if [[ -n $UPSTREAM_PORT ]] && wait_port_free "$UPSTREAM_PORT" \
    && [[ $UPSTREAM_PORT != "$LISTEN_PORT" ]] \
    && [[ $UPSTREAM_PORT != "$HTTPS_PORT" ]] \
    && [[ $UPSTREAM_PORT != 80 ]]; then
    return 0
  fi
  UPSTREAM_PORT=$(find_free_port_excluding "$((LISTEN_PORT + 1))" 80 "$LISTEN_PORT" "$HTTPS_PORT")
}

resolve_ports() {
  if tls_enabled; then
    if [[ $LISTEN_PORT == 80 || $LISTEN_PORT == 443 || $LISTEN_PORT == "$HTTPS_PORT" ]]; then
      warn "moving the plain HTTP front to 5002 so it does not conflict with HTTPS/ACME"
      LISTEN_PORT=5002
    fi
  fi
  select_listen_port
  if tls_enabled; then
    select_https_port
  fi
}

download_one_ui_base() {
  need curl
  local url=$1 dest=$2 tmp
  mkdir -p "$RUNNER_DIR"
  tmp="${dest}.tmp"
  if ! curl -fsSL --retry 3 "$url" -o "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  if (( $(wc -c < "$tmp") < 2000 )); then
    rm -f "$tmp"
    return 1
  fi
  mv "$tmp" "$dest"
  chmod 0644 "$dest"
}

download_ui_base() {
  local ok=1
  download_one_ui_base "$UI_URL" "$UI_BASE_FILE" || ok=0
  download_one_ui_base "$UI_V2_URL" "$UI_V2_BASE_FILE" || ok=0
  (( ok ))
}

ensure_ui_base() {
  local url dest
  if web_v2; then
    url=$UI_V2_URL
    dest=$UI_V2_BASE_FILE
  elif [[ $UI_MODE == modified ]]; then
    url=$UI_URL
    dest=$UI_BASE_FILE
  else
    return 0
  fi

  if download_one_ui_base "$url" "$dest"; then
    return 0
  fi
  if [[ -f $dest ]]; then
    warn "could not refresh the UI helper; using the installed copy"
    return 0
  fi
  die "failed to download the UI helper from ${url}"
}

write_ui() {
  local tmp="${UI_FILE}.tmp" key first=1 separator=""

  if web_v2; then
    if [[ ! -f $UI_V2_BASE_FILE ]]; then
      info "downloading the v2 quick toolbar helper"
      download_one_ui_base "$UI_V2_URL" "$UI_V2_BASE_FILE" || die "failed to download ${UI_V2_URL}"
    fi
    {
      printf 'window.__OPENWEB_V2__ = { "toolbar": true };\n'
      cat "$UI_V2_BASE_FILE"
    } > "$tmp"
    mv "$tmp" "$UI_FILE"
    chmod 0644 "$UI_FILE"
    return 0
  fi

  if [[ ! -f $UI_BASE_FILE ]]; then
    info "downloading the modified UI helper"
    download_one_ui_base "$UI_URL" "$UI_BASE_FILE" || die "failed to download ${UI_URL}"
  fi

  {
    printf 'window.__OPENWEB_FEATURES__ = {'
    for key in "${FEATURE_KEYS[@]}"; do
      if feature_is_on "$key"; then
        printf '%s"%s": true' "$separator" "$key"
      else
        printf '%s"%s": false' "$separator" "$key"
      fi
      if (( first )); then
        first=0
        separator=", "
      fi
    done
    printf '};\n'
    cat "$UI_BASE_FILE"
  } > "$tmp"
  mv "$tmp" "$UI_FILE"
  chmod 0644 "$UI_FILE"
}

