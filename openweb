  sudo openweb install --web v2
  sudo openweb install --modified --features usage,reasoning,theme
  sudo openweb install --original --port 8080
  sudo openweb install --domain 167.235.194.13.nip.io --tls letsencrypt
  sudo openweb addons install      # agent-skills + graphify
