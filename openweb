info() { printf '%s==>%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
progress_bar() {
  local pct=$1 width=24 filled i bar=""
  filled=$(( pct * width / 100 ))
  for ((i = 0; i < width; i++)); do
    if (( i < filled )); then bar+="█"; else bar+="░"; fi
  done
  printf '%s%s%s %s%3d%%%s' "$C_GREEN" "$bar" "$C_RESET" "$C_BOLD" "$pct" "$C_RESET"
}
progress() {
  local pct=$1
  shift
  printf '  '
  progress_bar "$pct"
  printf ' %s\n' "$*"
}
step() { printf '  %s-%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }
warn() { printf '%swarn:%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
error() { printf '%serror:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
die() {
  error "$*"
  exit 1
}

have() { command -v "$1" >/dev/null 2>&1; }
need() { have "$1" || die "missing dependency: $1"; }

public_ipv4() {
  local ip=""
  if have curl; then
    ip=$(curl -4 -fsS --max-time 5 https://api.ipify.org 2>/dev/null || true)
  fi
  if [[ -z $ip ]]; then
    ip=$(hostname -I 2>/dev/null | tr ' ' '\n' | awk '/^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ { print; exit }')
  fi
  printf '%s' "$ip"
}

default_domain() {
  local ip
  ip=$(public_ipv4)
  [[ -n $ip ]] && printf '%s.nip.io' "$ip"
}

domain_valid() {
  [[ $1 =~ ^([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?\.)+[A-Za-z]{2,}$ ]]
}

normalize_tls() {
  case ${1,,} in
    http | none | off | no) printf 'http' ;;
    letsencrypt | let\'s-encrypt | le | acme) printf 'letsencrypt' ;;
    custom | cert | file) printf 'custom' ;;
    *) return 1 ;;
  esac
}

normalize_web() {
  case ${1,,} in
    v1 | 1 | legacy) printf 'v1' ;;
    v2 | 2 | native) printf 'v2' ;;
    *) return 1 ;;
  esac
}

web_v2() {
  [[ ${WEB_API:-v1} == v2 ]]
}

tls_enabled() {
  [[ ${TLS_MODE:-http} != http ]]
}

ipv6_available() {
  [[ -f /proc/net/if_inet6 ]] && grep -q . /proc/net/if_inet6 2>/dev/null
}

use_nginx() {
  [[ $UI_MODE == modified || ${TLS_MODE:-http} != http ]]
}

usage() {
  cat <<EOF
${C_BOLD}openweb${C_RESET} ${C_DIM}v${SCRIPT_VERSION}${C_RESET} - install and manage OpenCode Web

${C_BOLD}Usage${C_RESET}
  sudo openweb [command] [options]

  Run without a command to open the numbered control panel.

${C_BOLD}Commands${C_RESET}
  install       Install or update OpenCode Web (interactive by default)
