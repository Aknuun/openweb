tls_cert_file() {
  if [[ $TLS_MODE == custom ]]; then
    printf '%s' "$TLS_CERT"
  else
    printf '/etc/letsencrypt/live/%s/fullchain.pem' "$DOMAIN"
  fi
}

tls_key_file() {
  if [[ $TLS_MODE == custom ]]; then
    printf '%s' "$TLS_KEY"
  else
    printf '/etc/letsencrypt/live/%s/privkey.pem' "$DOMAIN"
  fi
}

cert_exists() {
  local cert key
  cert=$(tls_cert_file)
  key=$(tls_key_file)
  [[ -n $cert && -n $key && -f $cert && -f $key ]]
}

certificate_needs_renewal() {
  local cert
  cert=$(tls_cert_file)
  [[ -n $cert && -f $cert ]] || return 0
  ! openssl x509 -checkend 86400 -noout -in "$cert" >/dev/null 2>&1
}

ensure_certbot() {
  have certbot && return 0
  info "certbot is required for Let's Encrypt; installing it"
  if have apt-get; then
    apt-get update -qq || die "apt-get update failed"
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq certbot || die "failed to install certbot"
  elif have dnf; then
    dnf install -y certbot || die "failed to install certbot"
  elif have yum; then
    yum install -y certbot || die "failed to install certbot"
  else
    die "certbot is required but no supported package manager was found"
  fi
}

install_deploy_hook() {
  mkdir -p "$(dirname "$CERTBOT_DEPLOY_HOOK")"
  cat > "$CERTBOT_DEPLOY_HOOK" <<'EOF'
#!/bin/sh
systemctl reload nginx >/dev/null 2>&1 || true
EOF
  chmod 0755 "$CERTBOT_DEPLOY_HOOK"
}

write_acme_conf() {
  mkdir -p /var/www/html
  chmod 0755 /var/www/html

  local ipv6_line=""
  if ipv6_available; then
    ipv6_line="    listen [::]:80;"
  fi

  cat > "$NGINX_ACME_CONF" <<EOF
server {
    listen 80;
${ipv6_line}
    server_name ${DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/html;
        default_type text/plain;
    }

    location / {
        return 404;
    }
}
EOF
  chmod 0644 "$NGINX_ACME_CONF"
}

issue_certificate() {
  ensure_certbot
  mkdir -p /var/www/html
  chmod 0755 /var/www/html

  info "requesting a Let's Encrypt certificate for ${DOMAIN}"
  write_acme_conf
  if ! reload_nginx 1; then
    rm -f "$NGINX_ACME_CONF"
    warn "could not activate the ACME challenge on port 80"
    return 1
  fi

  local -a args=(certonly --webroot -w /var/www/html -d "$DOMAIN" --non-interactive --agree-tos --keep-until-expiring --preferred-challenges http)
  if [[ -n $TLS_EMAIL ]]; then
    args+=(-m "$TLS_EMAIL")
  else
    args+=(--register-unsafely-without-email)
  fi

  if ! certbot "${args[@]}"; then
    rm -f "$NGINX_ACME_CONF"
    reload_nginx 1 >/dev/null 2>&1 || true
    error "Let's Encrypt certificate issuance failed for ${DOMAIN}. Check DNS and TCP port 80, or use --tls custom/http."
    return 1
  fi

  rm -f "$NGINX_ACME_CONF"
  reload_nginx 1 >/dev/null 2>&1 || true
  install_deploy_hook
  info "Let's Encrypt certificate is ready"
  return 0
}

ensure_nginx() {
  if ! have nginx; then
    info "nginx is required for the selected mode; installing it"
    if have apt-get; then
      apt-get update -qq || die "apt-get update failed"
      DEBIAN_FRONTEND=noninteractive apt-get install -y -qq nginx || die "failed to install nginx"
    elif have dnf; then
      dnf install -y nginx || die "failed to install nginx"
    elif have yum; then
      yum install -y nginx || die "failed to install nginx"
    else
      die "nginx is required but no supported package manager was found"
    fi
    NGINX_INSTALLED_BY_OPENWEB=1
  fi

  systemctl enable --now nginx >/dev/null 2>&1 || systemctl start nginx >/dev/null 2>&1 || true
  systemctl is-active --quiet nginx || die "nginx failed to start"
}

write_nginx() {
  local listen_line proxy_block ui_location sub_filter_line cert key
  local ipv6_plain="" ipv6_acme="" ipv6_https=""
  local http2_directive="" https_http2="" nginx_version major minor
  local https_redirect hsts_header nginx_user asset_prefix="/assets/"

  if ipv6_available; then
    ipv6_acme="    listen [::]:80;"
  fi

  nginx_version=$(nginx -v 2>&1 | sed -n 's#.*nginx/\([0-9][0-9.]*\).*#\1#p' | head -n 1)
  if [[ -n $nginx_version ]]; then
    major=${nginx_version%%.*}
    minor=${nginx_version#*.}
    minor=${minor%%.*}
    if (( major > 1 || (major == 1 && minor >= 25) )); then
      http2_directive="    http2 on;"
    else
      https_http2=" http2"
    fi
  else
    https_http2=" http2"
  fi

  if [[ $HTTPS_PORT == 443 ]]; then
    https_redirect="https://\$host\$request_uri"
    hsts_header='    add_header Strict-Transport-Security "max-age=31536000" always;'
  else
    https_redirect="https://\$host:${HTTPS_PORT}\$request_uri"
    hsts_header=""
  fi

  cat > "$NGINX_MAP" <<'EOF'
map $http_upgrade $openweb_connection_upgrade {
    default upgrade;
    ''      close;
}
EOF
  chmod 0644 "$NGINX_MAP"

  proxy_block="        proxy_pass http://127.0.0.1:${UPSTREAM_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header X-Forwarded-Host \$host;
        proxy_set_header X-Forwarded-Port \$server_port;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$openweb_connection_upgrade;
        proxy_set_header Accept-Encoding \"\";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;"

  ui_location=""
  sub_filter_line=""
  if [[ $UI_MODE == modified ]] || web_v2; then
    ui_location="    location = /__openweb/ui.js {
        auth_basic off;
        alias ${UI_FILE};
        default_type application/javascript;
        add_header Cache-Control \"no-store\";
    }
"
    sub_filter_line="        sub_filter '</body>' '<script src=\"/__openweb/ui.js\" defer></script></body>';
        sub_filter_once on;
"
  fi

  gzip_block="    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript text/javascript application/xml image/svg+xml application/manifest+json;"

  if web_v2; then
    asset_prefix="/_assets/"
  fi

  assets_location="    location ^~ ${asset_prefix} {
        proxy_pass http://127.0.0.1:${UPSTREAM_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Accept-Encoding \"\";
        proxy_hide_header Cache-Control;
        add_header Cache-Control \"public, max-age=31536000, immutable\";
    }
"

  provider_location=""
  if ! web_v2; then
    provider_location="    location = /provider {
        proxy_pass http://127.0.0.1:${UPSTREAM_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header X-Forwarded-Host \$host;
        proxy_set_header X-Forwarded-Port \$server_port;
        proxy_set_header Accept-Encoding \"\";
        proxy_cache openweb_cache;
        proxy_cache_key \"\$scheme\$request_method\$host\$request_uri\$http_authorization\";
        proxy_cache_methods GET HEAD;
        proxy_cache_valid 200 120s;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 10s;
        proxy_cache_background_update on;
        proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;
        proxy_cache_bypass \$http_cache_control;
        proxy_no_cache \$http_cache_control;
        proxy_hide_header Cache-Control;
        add_header Cache-Control \"private, max-age=60\";
        add_header X-OpenWeb-Cache \$upstream_cache_status;
        proxy_buffering on;
    }
"
  fi

  mkdir -p "$NGINX_CACHE_DIR"
  chmod 0700 "$NGINX_CACHE_DIR"
  nginx_user=$(sed -n 's/^user[[:space:]]\+\([^;]*\);.*/\1/p' /etc/nginx/nginx.conf 2>/dev/null | awk '{print $1}')
  [[ -n $nginx_user ]] || nginx_user=www-data
  if id "$nginx_user" >/dev/null 2>&1; then
    chown -R "$nginx_user" "$NGINX_CACHE_DIR" 2>/dev/null || true
  fi
  cat > "$NGINX_CACHE_CONF" <<EOF
proxy_cache_path ${NGINX_CACHE_DIR} levels=1:2 keys_zone=openweb_cache:16m max_size=128m inactive=10m use_temp_path=off;
EOF
  chmod 0644 "$NGINX_CACHE_CONF"

  rm -f "$NGINX_TLS_CONF" "$NGINX_ACME_CONF"

  {
    if tls_enabled && (( ACME_HTTP_AVAILABLE == 1 )); then
      cat <<EOF
server {
    listen 80;
${ipv6_acme}
    server_name ${DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/html;
        default_type text/plain;
    }

    location / {
        return 301 ${https_redirect};
    }
}
EOF
    fi

    if use_nginx && [[ $LISTEN_PORT != 80 && $LISTEN_PORT != "$HTTPS_PORT" ]]; then
      case $LISTEN_HOST in
        0.0.0.0) listen_line="listen ${LISTEN_PORT};" ;;
        ::) listen_line="listen [::]:${LISTEN_PORT};" ;;
        *:*) listen_line="listen [${LISTEN_HOST}]:${LISTEN_PORT};" ;;
        *) listen_line="listen ${LISTEN_HOST}:${LISTEN_PORT};" ;;
      esac
      if [[ $LISTEN_HOST == 0.0.0.0 ]] && ipv6_available; then
        ipv6_plain="    listen [::]:${LISTEN_PORT};"
      fi
      cat <<EOF

server {
    ${listen_line}
${ipv6_plain}
    server_name _;
    client_max_body_size 50m;

${gzip_block}

${provider_location}${assets_location}${ui_location}    location / {
${proxy_block}
${sub_filter_line}    }
}
EOF
    fi

    if tls_enabled; then
      cert=$(tls_cert_file)
      key=$(tls_key_file)
      if ipv6_available; then
        ipv6_https="    listen [::]:${HTTPS_PORT} ssl${https_http2};"
      fi
      cat <<EOF

server {
    listen ${HTTPS_PORT} ssl${https_http2};
${ipv6_https}
${http2_directive}
    server_name ${DOMAIN};
    ssl_certificate ${cert};
    ssl_certificate_key ${key};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

${hsts_header}
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy no-referrer always;

    client_max_body_size 50m;

${gzip_block}

${provider_location}${assets_location}${ui_location}    location / {
${proxy_block}
${sub_filter_line}    }
}
EOF
    fi
  } > "$NGINX_CONF"
  chmod 0644 "$NGINX_CONF"
}

reload_nginx() {
  local soft=${1:-0}
  if ! nginx -t 2>&1; then
    if (( soft )); then
      return 1
    fi
    die "nginx configuration test failed"
  fi
  if ! systemctl reload nginx 2>/dev/null; then
    if ! systemctl restart nginx 2>/dev/null; then
      if (( soft )); then
        return 1
      fi
      die "failed to reload nginx"
    fi
  fi
  return 0
}

remove_nginx() {
  local removed=0
  if [[ -f $NGINX_CONF ]]; then
    rm -f "$NGINX_CONF"
    removed=1
  fi
  if [[ -f $NGINX_MAP ]]; then
    rm -f "$NGINX_MAP"
    removed=1
  fi
  if [[ -f $NGINX_TLS_CONF ]]; then
    rm -f "$NGINX_TLS_CONF"
    removed=1
  fi
  if [[ -f $NGINX_ACME_CONF ]]; then
    rm -f "$NGINX_ACME_CONF"
    removed=1
  fi
  if [[ -f $NGINX_CACHE_CONF ]]; then
    rm -f "$NGINX_CACHE_CONF"
    removed=1
  fi
  rm -rf "$NGINX_CACHE_DIR"
  if (( removed )) && systemctl is-active --quiet nginx; then
    if ! nginx -t >/dev/null 2>&1 || ! systemctl reload nginx >/dev/null 2>&1; then
      warn "nginx could not be reloaded after removing the openweb configuration"
    fi
  fi
}

probe_host() {
  case $LISTEN_HOST in
    0.0.0.0) printf '127.0.0.1' ;;
    ::) printf '::1' ;;
    *) printf '%s' "$LISTEN_HOST" ;;
  esac
}

local_url() {
  local host
  host=$(probe_host)
  [[ $host == *:* ]] && host="[$host]"
  printf 'http://%s:%s/' "$host" "$LISTEN_PORT"
}

public_url() {
  local host
  case $LISTEN_HOST in
    0.0.0.0)
      host=$(hostname -I 2>/dev/null | tr ' ' '\n' | awk '/^[0-9.]+$/ { print; exit }')
      [[ -n $host ]] || host=127.0.0.1
      ;;
    ::)
      host=$(hostname -I 2>/dev/null | tr ' ' '\n' | awk '/:/ { print; exit }')
      [[ -n $host ]] || host='::1'
      ;;
    *) host=$LISTEN_HOST ;;
  esac
  [[ $host == *:* ]] && host="[$host]"
  printf 'http://%s:%s/' "$host" "$LISTEN_PORT"
}

health_url() {
  local host
  host=$(probe_host)
  [[ $host == *:* ]] && host="[$host]"
  printf 'http://%s:%s/' "$host" "$LISTEN_PORT"
}

https_url() {
  tls_enabled || return 1
  if [[ $HTTPS_PORT == 443 ]]; then
    printf 'https://%s/' "$DOMAIN"
  else
    printf 'https://%s:%s/' "$DOMAIN" "$HTTPS_PORT"
  fi
}

health_check() {
  local attempt code scheme host port path="/"
  local unauth_code
  local -a resolve_args=()
  local -a insecure_args=()

  if tls_enabled; then
    scheme=https
    host=$DOMAIN
    port=$HTTPS_PORT
    resolve_args=(--resolve "${DOMAIN}:${HTTPS_PORT}:127.0.0.1")
    if [[ $TLS_MODE == custom ]]; then
      insecure_args=(-k)
    fi
  else
    scheme=http
    host=$(probe_host)
    port=$LISTEN_PORT
    [[ $host == *:* ]] && host="[$host]"
  fi

  if web_v2; then
    path="/api/info"
  fi

  for ((attempt = 1; attempt <= 30; attempt++)); do
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
      "${resolve_args[@]}" "${insecure_args[@]}" \
      -u "${AUTH_USER}:${PASSWORD}" "${scheme}://${host}:${port}${path}" || true)
    case $code in
      200 | 204)
        if web_v2; then
          unauth_code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
            "${resolve_args[@]}" "${insecure_args[@]}" \
            "${scheme}://${host}:${port}/api/info" || true)
          if [[ $unauth_code == 200 ]]; then
            error "the v2 API is reachable without authentication"
            return 1
          fi
        fi
        return 0
        ;;
      301 | 302 | 303 | 307 | 308) return 0 ;;
    esac
    sleep 1
  done
  return 1
}

print_summary() {
  local http_url_value local_http_url https_value
  http_url_value=$(public_url)
  local_http_url=$(local_url)
  https_value=""
  if tls_enabled; then
    https_value=$(https_url)
  fi

  printf '\n'
  printf '%s================================================================%s\n' "$C_CYAN" "$C_RESET"
  printf '%s  OpenCode Web is installed and running%s\n' "$C_BOLD$C_GREEN" "$C_RESET"
  printf '%s================================================================%s\n' "$C_CYAN" "$C_RESET"

  if [[ -n $https_value ]]; then
    printf '  %sHTTPS URL%s    %s%s%s\n' "$C_BOLD" "$C_RESET" "$C_GREEN" "$https_value" "$C_RESET"
    printf '  %sHTTP URL%s     %s%s%s\n' "$C_BOLD" "$C_RESET" "$C_DIM" "$http_url_value" "$C_RESET"
  else
    printf '  %sURL%s          %s%s%s\n' "$C_BOLD" "$C_RESET" "$C_GREEN" "$http_url_value" "$C_RESET"
  fi
  if [[ $local_http_url != "$http_url_value" ]]; then
    printf '  %sLocal HTTP%s   %s%s%s\n' "$C_BOLD" "$C_RESET" "$C_DIM" "$local_http_url" "$C_RESET"
  fi

  printf '  %sUsername%s     %s%s%s\n' "$C_BOLD" "$C_RESET" "$C_YELLOW" "$AUTH_USER" "$C_RESET"
  printf '  %sPassword%s     %s%s%s\n' "$C_BOLD" "$C_RESET" "$C_MAGENTA" "$PASSWORD" "$C_RESET"

  if tls_enabled; then
    printf '  %sTLS%s          %s%s (%s)%s\n' "$C_BOLD" "$C_RESET" "$C_BLUE" "$TLS_MODE" "$DOMAIN" "$C_RESET"
    printf '  %sPorts%s        %sHTTP %s, HTTPS %s%s\n' "$C_BOLD" "$C_RESET" "$C_BLUE" "$LISTEN_PORT" "$HTTPS_PORT" "$C_RESET"
  else
    printf '  %sPort%s         %s\n' "$C_BOLD" "$C_RESET" "$LISTEN_PORT"
  fi

  if web_v2; then
    if use_nginx; then
      printf '  %sUI mode%s      %sv2 native (nginx -> 127.0.0.1:%s)%s\n' "$C_BOLD" "$C_RESET" "$C_BLUE" "$UPSTREAM_PORT" "$C_RESET"
    else
      printf '  %sUI mode%s      %sv2 native%s\n' "$C_BOLD" "$C_RESET" "$C_BLUE" "$C_RESET"
    fi
    printf '  %sSession sync%s %sshared with the v2 CLI server%s\n' "$C_BOLD" "$C_RESET" "$C_GREEN" "$C_RESET"
    printf '  %sToolbar%s      %sreasoning, theme, history, settings, refresh%s\n' "$C_BOLD" "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %sFeatures%s     %sv2 native + quick toolbar%s\n' "$C_BOLD" "$C_RESET" "$C_DIM" "$C_RESET"
  elif [[ $UI_MODE == modified ]]; then
    printf '  %sUI mode%s      %smodified (nginx -> 127.0.0.1:%s)%s\n' "$C_BOLD" "$C_RESET" "$C_BLUE" "$UPSTREAM_PORT" "$C_RESET"
    printf '  %sFeatures%s     %s\n' "$C_BOLD" "$C_RESET" "$(features_normalized)"
    [[ -n $FEATURES ]] || printf '                 %snone%s\n' "$C_DIM" "$C_RESET"
  else
    printf '  %sUI mode%s      %soriginal (unmodified OpenCode UI)%s\n' "$C_BOLD" "$C_RESET" "$C_BLUE" "$C_RESET"
  fi

  if [[ -n $OPENCODE_BIN && -x $OPENCODE_BIN ]]; then
    printf '  %sOpenCode%s     %s (%s)\n' "$C_BOLD" "$C_RESET" "$("$OPENCODE_BIN" --version 2>/dev/null || printf 'unknown')" "$OPENCODE_BIN"
  fi
  printf '  %sService%s      %s%s%s\n' "$C_BOLD" "$C_RESET" "$C_BLUE" "$SERVICE_NAME" "$C_RESET"
  printf '  %sConfig%s       %s\n' "$C_BOLD" "$C_RESET" "$CONFIG_DIR"
  printf '\n  %sManage%s\n' "$C_BOLD" "$C_RESET"
  if web_v2; then
    printf '    sudo openweb install --web v1  # switch to v1 + custom UI features\n'
  else
    printf '    sudo openweb features          # numbered feature manager\n'
    printf '    sudo openweb features 1 3 5    # toggle features by number\n'
  fi
  printf '    sudo openweb status\n'
  printf '    sudo openweb update\n'
  printf '    sudo openweb password\n'
  printf '    sudo openweb uninstall\n'
  printf '\n  %sKeep these credentials somewhere safe.%s\n' "$C_YELLOW" "$C_RESET"

  if tls_enabled; then
    if (( ACME_HTTP_AVAILABLE == 1 )); then
      printf '  %sTLS:%s HTTPS is enabled with %s. Ports 80 and %s must stay reachable for certificate renewal.\n' "$C_GREEN" "$C_RESET" "$TLS_MODE" "$HTTPS_PORT"
      printf '  %sFirewall:%s if a firewall is enabled, allow TCP 80 and %s (for example: sudo ufw allow 80/tcp; sudo ufw allow %s/tcp).\n' "$C_RED" "$C_RESET" "$HTTPS_PORT" "$HTTPS_PORT"
    else
      printf '  %sTLS warning:%s port 80 is unavailable, so the HTTP redirect and automatic certificate renewal are disabled. Use the HTTPS URL above.\n' "$C_YELLOW" "$C_RESET"
      printf '  %sFirewall:%s allow TCP %s for HTTPS.\n' "$C_RED" "$C_RESET" "$HTTPS_PORT"
    fi
  elif [[ $LISTEN_HOST == 0.0.0.0 || $LISTEN_HOST == '::' || $LISTEN_HOST == '*' ]]; then
    printf '  %sSecurity:%s the service is exposed over plain HTTP. Add HTTPS with: sudo openweb install --domain <name>.nip.io --tls letsencrypt\n' "$C_RED" "$C_RESET"
    printf '  %sFirewall:%s if a firewall is enabled, allow TCP %s (for example: sudo ufw allow %s/tcp).\n' "$C_RED" "$C_RESET" "$LISTEN_PORT" "$LISTEN_PORT"
  fi

  printf '%s================================================================%s\n\n' "$C_CYAN" "$C_RESET"
}

install_manager() {
  local source=${BASH_SOURCE[0]:-}
  if [[ -n $source && -f $source ]]; then
    local source_real dest_real=""
    source_real=$(readlink -f "$source")
    [[ -e $MANAGER_BIN ]] && dest_real=$(readlink -f "$MANAGER_BIN")
    if [[ $source_real != "$dest_real" ]]; then
      install -m 0755 "$source" "$MANAGER_BIN"
    fi
    return 0
  fi

  need curl
  local tmp
  tmp=$(mktemp)
  if curl -fsSL --retry 3 "$SCRIPT_URL" -o "$tmp"; then
    install -m 0755 "$tmp" "$MANAGER_BIN"
  else
    warn "could not install the 'openweb' command; download it from ${REPO_URL}"
  fi
  rm -f "$tmp"
}

load_config() {
  [[ -f $CONFIG_FILE ]] || die "OpenCode Web is not installed (missing ${CONFIG_FILE})"
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  : "${UI_MODE:=original}"
  : "${WEB_API:=v1}"
  : "${FEATURES:=}"
  : "${UPSTREAM_PORT:=}"
  : "${DOMAIN:=}"
  : "${TLS_MODE:=http}"
  : "${TLS_CERT:=}"
  : "${TLS_KEY:=}"
  : "${TLS_EMAIL:=}"
  : "${HTTPS_PORT:=}"
  FEATURES_SET=1
  if tls_enabled; then
    if port_available_for_nginx 80; then
      ACME_HTTP_AVAILABLE=1
    else
      ACME_HTTP_AVAILABLE=0
    fi
  fi
  SERVICE_HOME=$(getent passwd "$SERVICE_USER" | cut -d: -f6)
}

config_value() {
  [[ -f $CONFIG_FILE ]] || return 0
  sed -n "s/^$1=//p" "$CONFIG_FILE" | head -n 1
}

interactive_wizard() {
  local default_mode=2 default_tls=1 default_web=1 auto_domain
  if [[ $UI_MODE == original ]]; then
    default_mode=1
  fi
  if web_v2; then
    default_web=2
  fi

  while true; do
    printf '\n%sWeb engine%s\n' "$C_BOLD" "$C_RESET" >/dev/tty
    printf '  1) v1.19.4 + custom UI features (modified UI)\n' >/dev/tty
    printf '  2) v2 native UI (sessions shared with the CLI server)\n' >/dev/tty
    read_value "Web engine" "$default_web"
    case $REPLY_VALUE in
      1 | v1 | V1) WEB_API=v1; break ;;
      2 | v2 | V2) WEB_API=v2; break ;;
      *) warn "choose 1 or 2" ;;
    esac
  done

  if web_v2; then
    UI_MODE=original
    info "v2 native UI selected; sessions are shared with the v2 CLI server"
  else
    while true; do
      read_value "Install mode (1=original, 2=modified)" "$default_mode"
      case $REPLY_VALUE in
        1 | original | Original) UI_MODE=original; break ;;
        2 | modified | Modified) UI_MODE=modified; break ;;
        *) warn "choose 1 or 2" ;;
      esac
    done

    if [[ $UI_MODE == modified ]]; then
      if (( FEATURES_SET == 0 )); then
        set_features "$DEFAULT_FEATURES"
      fi
      features_menu || true
    fi
  fi

  while true; do
    read_value "Plain HTTP address" "$LISTEN_HOST"
    if host_valid "$REPLY_VALUE"; then
      LISTEN_HOST=$REPLY_VALUE
      break
    fi
    warn "invalid listen address"
  done

  while true; do
    read_value "Plain HTTP port" "$LISTEN_PORT"
    if port_valid "$REPLY_VALUE"; then
      LISTEN_PORT=$REPLY_VALUE
      break
    fi
    warn "port must be between 1 and 65535"
  done

  while true; do
    read_value "Login username" "$AUTH_USER"
    if auth_user_valid "$REPLY_VALUE"; then
      AUTH_USER=$REPLY_VALUE
      break
    fi
    warn "username may only contain letters, digits, dot, underscore and dash"
  done

  auto_domain=$(default_domain)
  [[ -n $DOMAIN ]] || DOMAIN=$auto_domain
  case ${TLS_MODE:-} in
    custom) default_tls=3 ;;
    *) default_tls=1 ;;
  esac

  while true; do
    printf '\n%sHTTPS / TLS%s\n' "$C_BOLD" "$C_RESET" >/dev/tty
    printf '  1) Let\047s Encrypt (automatic HTTPS, recommended)\n' >/dev/tty
    printf '  2) HTTP only\n' >/dev/tty
    printf '  3) Custom certificate\n' >/dev/tty
    read_value "TLS mode" "$default_tls"
    case $REPLY_VALUE in
      1 | letsencrypt | le | LetsEncrypt) TLS_MODE=letsencrypt; break ;;
      2 | http | none | off | HTTP) TLS_MODE=http; break ;;
      3 | custom | cert | Custom) TLS_MODE=custom; break ;;
      *) warn "choose 1, 2 or 3" ;;
    esac
  done

  if tls_enabled; then
    while true; do
      read_value "HTTPS domain" "${DOMAIN:-$auto_domain}"
      if domain_valid "$REPLY_VALUE"; then
        DOMAIN=$REPLY_VALUE
        break
      fi
      warn "enter a valid domain name"
    done

    if [[ $TLS_MODE == letsencrypt ]]; then
      read_value "Let's Encrypt email (optional)" "$TLS_EMAIL"
      TLS_EMAIL=$REPLY_VALUE
      if [[ -z $TLS_EMAIL ]]; then
        warn "no email given; certbot will register without an email address"
      fi
    else
      while true; do
        read_value "Certificate file" "$TLS_CERT"
        if [[ -n $REPLY_VALUE && -f $REPLY_VALUE ]]; then
          TLS_CERT=$REPLY_VALUE
          break
        fi
        warn "certificate file not found"
      done
      while true; do
        read_value "Private key file" "$TLS_KEY"
        if [[ -n $REPLY_VALUE && -f $REPLY_VALUE ]]; then
          TLS_KEY=$REPLY_VALUE
          break
        fi
        warn "private key file not found"
      done
    fi

    while true; do
      read_value "HTTPS port" "$HTTPS_PORT"
      if port_valid "$REPLY_VALUE" && [[ $REPLY_VALUE != "$LISTEN_PORT" ]] && [[ $REPLY_VALUE != 80 ]]; then
        HTTPS_PORT=$REPLY_VALUE
        break
      fi
      warn "HTTPS port must differ from the plain HTTP port and cannot be 80"
    done
  fi

  if tls_enabled && [[ $LISTEN_PORT == 80 ]]; then
    warn "port 80 is reserved for the ACME challenge and redirect"
    while true; do
      read_value "Plain HTTP port" "5002"
      if port_valid "$REPLY_VALUE" && [[ $REPLY_VALUE != "$HTTPS_PORT" ]] && [[ $REPLY_VALUE != 80 ]]; then
        LISTEN_PORT=$REPLY_VALUE
        break
      fi
      warn "choose another port"
    done
  fi

  printf '\n%sInstall summary%s\n' "$C_BOLD" "$C_RESET"
  printf '  Web       : %s\n' "$WEB_API"
  printf '  Mode      : %s\n' "$UI_MODE"
  printf '  HTTP      : %s:%s\n' "$LISTEN_HOST" "$LISTEN_PORT"
  printf '  Username  : %s\n' "$AUTH_USER"
  if web_v2; then
    printf '  Sync      : sessions shared with the v2 CLI server\n'
  elif [[ $UI_MODE == modified ]]; then
    printf '  Features  : %s\n' "$(features_normalized)"
  fi
  if tls_enabled; then
    printf '  TLS       : %s (%s)\n' "$TLS_MODE" "$DOMAIN"
    printf '  HTTPS     : %s\n' "$(https_url)"
  fi
  printf '\n'
  confirm "Proceed with these settings?" || {
    info "aborted"
    exit 0
  }
}

apply_ui() {
  systemctl stop "$SERVICE_NAME" 2>/dev/null || true

  if use_nginx; then
    ensure_nginx
  else
    remove_nginx
  fi

  # Pick free ports instead of failing when 443, 80 or the plain HTTP port is taken.
  resolve_ports
  if use_nginx; then
    select_upstream_port
  fi

  ACME_HTTP_AVAILABLE=1
  if tls_enabled; then
    if port_available_for_nginx 80; then
      ACME_HTTP_AVAILABLE=1
    else
      ACME_HTTP_AVAILABLE=0
      warn "port 80 is in use by another service; the HTTP redirect and automatic certificate renewal will be skipped"
    fi
  fi

  if tls_enabled && [[ $TLS_MODE == letsencrypt ]]; then
    ensure_certbot
    if ! cert_exists || certificate_needs_renewal; then
      if (( ACME_HTTP_AVAILABLE == 0 )); then
        warn "cannot request a Let's Encrypt certificate because port 80 is unavailable; continuing without HTTPS"
        TLS_MODE=http
        HTTPS_PORT=""
      else
        progress 40 "requesting the TLS certificate"
        if ! issue_certificate; then
          warn "certificate issuance failed; continuing without HTTPS (fix DNS/port 80 and rerun)"
          TLS_MODE=http
          HTTPS_PORT=""
        fi
      fi
    else
      install_deploy_hook
    fi
  fi

  if ! tls_enabled; then
    ACME_HTTP_AVAILABLE=0
  fi

  # If TLS fell back to HTTP and the original UI is selected, nginx is no longer needed.
  if ! use_nginx; then
    remove_nginx
    resolve_ports
  fi

  progress 55 "writing configuration"
  mkdir -p "$CONFIG_DIR" "$RUNNER_DIR"
  chmod 0755 "$CONFIG_DIR" "$RUNNER_DIR"

  if [[ $UI_MODE == modified ]] || web_v2; then
    progress 65 "preparing the UI helper"
    write_ui
  fi

  if ! tls_enabled; then
    rm -f "$CERTBOT_DEPLOY_HOOK"
  fi

  write_config
  write_runner
  write_unit

  if use_nginx; then
    progress 80 "configuring nginx"
    write_nginx
    reload_nginx
  fi

  progress 88 "enabling the systemd service"
  systemctl daemon-reload
  systemctl enable "$SERVICE_NAME" >/dev/null
  systemctl restart "$SERVICE_NAME"

  progress 94 "waiting for the web interface"
  if ! health_check; then
    error "the service did not become healthy"
    journalctl -u "$SERVICE_NAME" -n 40 --no-pager >&2 || true
    if use_nginx; then
      printf '%snginx error log:%s\n' "$C_DIM" "$C_RESET" >&2
      tail -n 20 /var/log/nginx/error.log 2>/dev/null >&2 || true
    fi
    die "installation failed; check the logs and run 'openweb install' again"
  fi

  progress 98 "installing the openweb command"
  install_manager
  progress 100 "done"
  print_summary
}

apply_overrides() {
  [[ -n $ENV_UI ]] && UI_MODE=$ENV_UI
  if [[ -n $ENV_WEB ]]; then
    WEB_API=$(normalize_web "$ENV_WEB") || die "invalid OPENWEB_WEB: ${ENV_WEB}"
  fi
  [[ -n $ENV_FEATURES ]] && set_features "$ENV_FEATURES"
  [[ -n $ENV_DOMAIN ]] && DOMAIN=$ENV_DOMAIN
  if [[ -n $ENV_TLS ]]; then
    TLS_MODE=$(normalize_tls "$ENV_TLS") || die "invalid OPENWEB_TLS: ${ENV_TLS}"
  fi
  [[ -n $ENV_TLS_CERT ]] && TLS_CERT=$ENV_TLS_CERT
  [[ -n $ENV_TLS_KEY ]] && TLS_KEY=$ENV_TLS_KEY
  [[ -n $ENV_EMAIL ]] && TLS_EMAIL=$ENV_EMAIL
  [[ -n $ENV_HTTPS_PORT ]] && HTTPS_PORT=$ENV_HTTPS_PORT

  [[ -n $OPT_PORT ]] && LISTEN_PORT=$OPT_PORT
  [[ -n $OPT_HOST ]] && LISTEN_HOST=$OPT_HOST
  [[ -n $OPT_USER ]] && SERVICE_USER=$OPT_USER
  [[ -n $OPT_AUTH_USER ]] && AUTH_USER=$OPT_AUTH_USER
  [[ -n $OPT_UI_MODE ]] && UI_MODE=$OPT_UI_MODE
  if [[ -n $OPT_WEB ]]; then
    WEB_API=$(normalize_web "$OPT_WEB") || die "invalid --web value: ${OPT_WEB}"
  fi
  if (( OPT_FEATURES_SET == 1 )); then
    set_features "$OPT_FEATURES"
  fi
  [[ -n $OPT_DOMAIN ]] && DOMAIN=$OPT_DOMAIN
  if [[ -n $OPT_TLS ]]; then
    TLS_MODE=$(normalize_tls "$OPT_TLS") || die "invalid --tls value: ${OPT_TLS}"
  fi
  [[ -n $OPT_TLS_CERT ]] && TLS_CERT=$OPT_TLS_CERT
  [[ -n $OPT_TLS_KEY ]] && TLS_KEY=$OPT_TLS_KEY
  [[ -n $OPT_EMAIL ]] && TLS_EMAIL=$OPT_EMAIL
  [[ -n $OPT_HTTPS_PORT ]] && HTTPS_PORT=$OPT_HTTPS_PORT
  return 0
}

cmd_install() {
  require_root
  need systemctl
  ensure_host_prereqs
  progress 15 "installing or updating OpenCode"
  ensure_latest_opencode
  need curl

  local installed=0 wizard_ran=0
  if [[ -f $CONFIG_FILE ]]; then
    installed=1
    load_config
    if [[ -z $PASSWORD && -f $PASSWORD_FILE ]]; then
      PASSWORD=$(cat "$PASSWORD_FILE")
      PASSWORD_REUSED=1
    fi
  fi

  apply_overrides

  if [[ $OPT_UI_MODE == original ]] && (( OPT_FEATURES_SET == 1 )) && [[ -n $FEATURES ]]; then
    die "cannot combine --original with --features"
  fi

  if (( installed == 1 )) && (( REUSE == 0 )); then
    if ! confirm "OpenCode Web is already installed. Reinstall/update it?"; then
      info "aborted"
      return 0
    fi
  fi

  if (( REUSE == 0 )) && is_interactive; then
    interactive_wizard
    wizard_ran=1
  fi

  if web_v2; then
    if [[ $UI_MODE == modified ]]; then
      warn "the v2 native UI does not use the custom v1 features; switching to the original v2 UI"
    fi
    UI_MODE=original
  fi

  if [[ -z $TLS_MODE ]]; then
    if [[ -n $OPT_DOMAIN || -n $ENV_DOMAIN ]]; then
      TLS_MODE=letsencrypt
    else
      TLS_MODE=http
    fi
  elif (( wizard_ran == 0 )) && [[ -n $OPT_DOMAIN || -n $ENV_DOMAIN ]] && [[ -z $OPT_TLS && -z $ENV_TLS ]]; then
    TLS_MODE=letsencrypt
  fi

  if tls_enabled && [[ -z $DOMAIN ]]; then
    DOMAIN=$(default_domain)
  fi
  if tls_enabled && [[ -z $DOMAIN ]]; then
    die "could not determine a public nip.io domain; pass --domain <name>"
  fi

  if (( OPT_FEATURES_SET == 1 )) && [[ -z $OPT_UI_MODE ]] && [[ -z $ENV_UI ]]; then
    if [[ -z $FEATURES ]]; then
      UI_MODE=original
    else
      UI_MODE=modified
    fi
  fi

  if [[ -z $UI_MODE ]]; then
    UI_MODE=original
  fi
  if [[ $UI_MODE == modified ]] && (( FEATURES_SET == 0 )); then
    set_features "$DEFAULT_FEATURES"
  fi

  resolve_ports
  validate_settings

  if [[ -z $PASSWORD ]]; then
    if (( installed == 1 )) && [[ -f $PASSWORD_FILE ]]; then
      PASSWORD=$(cat "$PASSWORD_FILE")
      PASSWORD_REUSED=1
    else
      prompt_password
    fi
  else
    prompt_password
  fi

  if (( PASSWORD_REUSED == 1 )); then
    info "keeping the existing password (change it with 'openweb password')"
  fi

  ensure_compatible_opencode
  [[ -x $OPENCODE_BIN ]] || die "OpenCode binary is not executable: $OPENCODE_BIN"
  case $OPENCODE_BIN in
    *[\"\$\`\\]* | *$'\n'*) die "unsupported character in OpenCode path: $OPENCODE_BIN" ;;
  esac

  mkdir -p "$CONFIG_DIR"
  chmod 0755 "$CONFIG_DIR"
  ( umask 077; printf '%s' "$PASSWORD" > "$PASSWORD_FILE" )
  chown "root:${SERVICE_GROUP}" "$PASSWORD_FILE"
  chmod 0640 "$PASSWORD_FILE"

  ensure_ui_base
  apply_ui
}

cmd_update() {
  require_root
  need curl

  info "checking for the latest openweb"
  local tmp new_version
  tmp=$(mktemp)
  if ! curl -fsSL --retry 3 "$SCRIPT_URL" -o "$tmp"; then
    rm -f "$tmp"
    die "failed to download ${SCRIPT_URL}"
  fi
  if ! bash -n "$tmp"; then
    rm -f "$tmp"
    die "the downloaded script failed its syntax check"
  fi
  new_version=$(bash "$tmp" --version 2>/dev/null || true)
  [[ -n $new_version ]] || new_version="unknown"

  if download_ui_base; then
    step "UI helper updated"
  else
    warn "could not refresh the UI helper; the existing copy will be used"
  fi

  install -m 0755 "$tmp" "$MANAGER_BIN"
  rm -f "$tmp"
  info "manager updated to v${new_version}"

  if [[ -f $UNIT_FILE ]]; then
    info "reapplying the current configuration"
    "$MANAGER_BIN" install --yes --reuse
  fi
}

resolve_feature_token() {
  local token=$1 key
  if key=$(feature_by_number "$token"); then
    printf '%s' "$key"
    return 0
  fi
  token=${token,,}
  if feature_known "$token"; then
    printf '%s' "$token"
    return 0
  fi
  return 1
}

features_apply_tokens() {
  local mode=$1
  shift
  local token key
  local -a parts=()

  if [[ $mode == set ]]; then
    FEATURES=""
  fi

  for token in "$@"; do
    IFS=',' read -r -a parts <<< "$token"
    for key in "${parts[@]}"; do
      [[ -n $key ]] || continue
      if [[ ${key,,} == all ]]; then
        if [[ $mode == disable ]]; then
          FEATURES=""
          FEATURES_SET=1
        else
          set_features all
        fi
        continue
      fi
      if [[ ${key,,} == none ]]; then
        if [[ $mode == enable ]]; then
          continue
        fi
        FEATURES=""
        FEATURES_SET=1
        continue
      fi
      key=$(resolve_feature_token "$key") || die "unknown feature or number: ${key} (features: 1-${#FEATURE_KEYS[@]}, ${FEATURE_KEYS[*]})"
      case $mode in
        toggle)
          if feature_is_on "$key"; then features_remove "$key"; else feature_add "$key"; fi
          ;;
        enable) feature_add "$key" ;;
        disable) features_remove "$key" ;;
        set) feature_add "$key" ;;
      esac
    done
  done

  FEATURES=$(features_normalized)
  FEATURES_SET=1
}

cmd_features() {
  require_root
  load_config
  [[ -f $UNIT_FILE ]] || die "OpenCode Web is not installed"

  if web_v2; then
    info "The v2 native web UI is active."
    info "v2 includes its own progress indicator and shares sessions with the CLI server."
    info "The quick toolbar (reasoning/theme/history/settings/refresh) is installed in the titlebar."
    info "Custom v1 UI features are disabled. To switch: sudo openweb install --web v1"
    return 0
  fi

  local action=${1:-}
  case $action in
    list)
      features_list
      return 0
      ;;
    enable | on)
      shift
      [[ $# -gt 0 ]] || die "usage: openweb features enable <number|name> [number|name ...]"
      features_apply_tokens enable "$@"
      [[ -n $FEATURES ]] && UI_MODE=modified
      ;;
    disable | off)
      shift
      [[ $# -gt 0 ]] || die "usage: openweb features disable <number|name> [number|name ...]"
      features_apply_tokens disable "$@"
      ;;
    set)
      shift
      [[ $# -gt 0 ]] || die "usage: openweb features set <number|name|all|none> ..."
      features_apply_tokens set "$@"
      [[ -n $FEATURES ]] && UI_MODE=modified
      ;;
    reset)
      set_features "$DEFAULT_FEATURES"
      UI_MODE=modified
      ;;
    '')
      is_interactive || die "use 'openweb features list|enable|disable|set' in non-interactive mode"
      UI_MODE=modified
      if ! features_menu; then
        info "no changes"
        return 0
      fi
      ;;
    [[:digit:]]* | *,*)
      features_apply_tokens toggle "$@"
      [[ -n $FEATURES ]] && UI_MODE=modified
      ;;
    *)
      die "unknown features action: ${action} (list|enable|disable|set|reset|on|off|numbers)"
      ;;
  esac

  PASSWORD=$(cat "$PASSWORD_FILE" 2>/dev/null || true)
  [[ -n $PASSWORD ]] || die "password file is missing; run 'openweb install'"

  resolve_ports
  validate_settings
  apply_ui
  printf '  %sReload the browser tab to apply feature changes.%s\n\n' "$C_DIM" "$C_RESET"
}

run_as_service_user() {
  if [[ $SERVICE_USER == root ]]; then
    HOME="$SERVICE_HOME" "$@"
  elif have runuser; then
    runuser -u "$SERVICE_USER" -- env HOME="$SERVICE_HOME" "$@"
  else
    die "runuser is required to act as ${SERVICE_USER}"
  fi
}

service_user_shell() {
  if [[ $SERVICE_USER == root ]]; then
    HOME="$SERVICE_HOME" bash -c "$1"
  elif have runuser; then
    runuser -u "$SERVICE_USER" -- env HOME="$SERVICE_HOME" PATH="$SERVICE_HOME/.local/bin:/usr/local/bin:/usr/bin:/bin" bash -c "$1"
  else
    die "runuser is required to act as ${SERVICE_USER}"
  fi
}

host_run() {
  if [[ -w /usr/local/bin ]]; then
    "$@"
    return 0
  fi
  have systemd-run || die "cannot write /usr/local/bin; run this command outside the OpenWeb sandbox"
  local unit="openweb-addon-$$-$RANDOM"
  if ! systemd-run --unit="$unit" --wait --collect --property=ProtectSystem=no -- "$@" >/dev/null 2>&1; then
    die "could not run in the host namespace: $*"
  fi
}

ensure_uv() {
  local uv_bin=""
  if [[ -x "$SERVICE_HOME/.local/bin/uv" ]]; then
    uv_bin="$SERVICE_HOME/.local/bin/uv"
  elif have uv; then
    uv_bin=$(command -v uv)
  fi
  if [[ -z $uv_bin ]]; then
    need curl
    info "installing uv for ${SERVICE_USER}"
    service_user_shell 'curl -LsSf https://astral.sh/uv/install.sh | sh' >&2 || die "failed to install uv"
    uv_bin="$SERVICE_HOME/.local/bin/uv"
  fi
  [[ -x $uv_bin ]] || die "uv was not found after installation"
  printf '%s' "$uv_bin"
}

extract_tarball() {
  local archive=$1 dest=$2
  need python3
  python3 - "$archive" "$dest" <<'PY'
import os, sys, tarfile

archive, dest = sys.argv[1], sys.argv[2]
dest_real = os.path.realpath(dest)
with tarfile.open(archive, "r:gz") as tf:
    try:
        tf.extractall(dest, filter="data")
    except TypeError:
        for member in tf.getmembers():
            target = os.path.realpath(os.path.join(dest, member.name))
            if target != dest_real and not target.startswith(dest_real + os.sep):
                raise RuntimeError("unsafe path in archive: " + member.name)
        tf.extractall(dest)
PY
}

install_agent_skills() {
  need curl
  need python3
  info "installing agent-skills for ${SERVICE_USER}"

  local tmp src dest_skills dest_refs count
  tmp=$(mktemp -d "${SERVICE_HOME}/.openweb-addons.XXXXXX")
  if ! curl -fsSL --retry 3 "$AGENT_SKILLS_TARBALL" -o "$tmp/skills.tar.gz"; then
    rm -rf "$tmp"
    die "failed to download agent-skills"
  fi
  if ! extract_tarball "$tmp/skills.tar.gz" "$tmp"; then
    rm -rf "$tmp"
    die "failed to extract agent-skills"
  fi

  src=$(find "$tmp" -maxdepth 2 -type d -name skills -print -quit)
  [[ -n $src ]] || { rm -rf "$tmp"; die "agent-skills archive has no skills directory"; }
  src=${src%/skills}

  dest_skills="$SERVICE_HOME/.config/opencode/skills"
  dest_refs="$SERVICE_HOME/.config/opencode/references"
  mkdir -p "$dest_skills" "$dest_refs"
  cp -a "$src/skills/." "$dest_skills/"
  if [[ -d "$src/references" ]]; then
    cp -a "$src/references/." "$dest_refs/"
  fi
  chown -R "${SERVICE_USER}:${SERVICE_GROUP}" "$dest_skills" "$dest_refs" 2>/dev/null || true
  count=$(find "$dest_skills" -mindepth 1 -maxdepth 1 -type d ! -name graphify | wc -l)
  rm -rf "$tmp"
  info "agent-skills installed (${count} skills)"
}

install_graphify() {
  need curl
  info "installing graphify for ${SERVICE_USER}"

  local uv_bin graphify_bin version
  uv_bin=$(ensure_uv)
  if ! run_as_service_user "$uv_bin" tool install --python 3.12 "$GRAPHIFY_PACKAGE" >&2; then
    die "failed to install ${GRAPHIFY_PACKAGE}"
  fi

  graphify_bin="$SERVICE_HOME/.local/bin/graphify"
  [[ -x $graphify_bin ]] || die "graphify was not installed"

  ( cd "$SERVICE_HOME" && run_as_service_user "$graphify_bin" install --platform opencode ) >&2 \
    || die "graphify install --platform opencode failed"

  host_run /bin/ln -sf "$graphify_bin" /usr/local/bin/graphify
  if [[ -x "$SERVICE_HOME/.local/bin/graphify-mcp" ]]; then
    host_run /bin/ln -sf "$SERVICE_HOME/.local/bin/graphify-mcp" /usr/local/bin/graphify-mcp || true
  fi

  version=$("$graphify_bin" --version 2>/dev/null || printf 'unknown')
  info "${version} installed"
}

install_opencode_plugin() {
  local package=$1 label=$2 cli
  cli=$(find_system_opencode || true)
  [[ -n $cli ]] || die "OpenCode v2 CLI not found"
  info "installing ${label} plugin"
  ( cd "$SERVICE_HOME" && run_as_service_user "$cli" plugin add "$package" ) >&2 \
    || die "failed to install ${package}"
}

install_context_pruning() {
  install_opencode_plugin "$DCP_PLUGIN_PACKAGE" "dynamic context pruning"
}

install_memory() {
  install_opencode_plugin "$MEM_PLUGIN_PACKAGE" "opencode-mem"
}

addons_status() {
  local skills_dir="$SERVICE_HOME/.config/opencode/skills"
  local agent_state="${C_DIM}off${C_RESET}"
  local graph_state="${C_DIM}off${C_RESET}"
  local dcp_state="${C_DIM}off${C_RESET}"
  local mem_state="${C_DIM}off${C_RESET}"
  local count=0
  local config_file="$SERVICE_HOME/.config/opencode/opencode.jsonc"
  [[ -f $config_file ]] || config_file="$SERVICE_HOME/.config/opencode/opencode.json"

  if [[ -f "$skills_dir/using-agent-skills/SKILL.md" ]]; then
    count=$(find "$skills_dir" -mindepth 1 -maxdepth 1 -type d ! -name graphify | wc -l)
    agent_state="${C_GREEN}on${C_RESET} (${count} skills)"
  fi
  if [[ -f "$skills_dir/graphify/SKILL.md" ]] \
    && [[ -f "$SERVICE_HOME/.opencode/plugins/graphify.js" ]] \
    && [[ -x /usr/local/bin/graphify || -x "$SERVICE_HOME/.local/bin/graphify" ]]; then
    graph_state="${C_GREEN}on${C_RESET}"
  fi
  if [[ -f $config_file ]] && grep -q 'opencode-dcp' "$config_file" 2>/dev/null; then
    dcp_state="${C_GREEN}on${C_RESET}"
  fi
  if [[ -f $config_file ]] && grep -q 'opencode-mem' "$config_file" 2>/dev/null; then
    mem_state="${C_GREEN}on${C_RESET}"
  fi

  printf '%sOptional agent skills%s\n' "$C_BOLD" "$C_RESET"
  printf '  %sagent-skills%s  %b\n' "$C_BOLD" "$C_RESET" "$agent_state"
  printf '  %sgraphify%s      %b\n' "$C_BOLD" "$C_RESET" "$graph_state"
  printf '  %scontext-pruning%s %b\n' "$C_BOLD" "$C_RESET" "$dcp_state"
  printf '  %smemory%s        %b\n' "$C_BOLD" "$C_RESET" "$mem_state"
  printf '  %sskills dir%s    %s\n' "$C_BOLD" "$C_RESET" "$skills_dir"
}

cmd_addons() {
  require_root
  load_config
  [[ -f $UNIT_FILE ]] || die "OpenCode Web is not installed"

  local action=${1:-install}
  shift || true

  case $action in
    status)
      addons_status
      ;;
    install)
      local -a targets=("$@")
      if (( ${#targets[@]} == 0 )); then
        targets=(all)
      fi
      local target
      for target in "${targets[@]}"; do
        case $target in
          all)
            install_agent_skills
            install_graphify
            install_context_pruning
            install_memory
            ;;
          agent-skills | skills)
            install_agent_skills
            ;;
          graphify)
            install_graphify
            ;;
          context-pruning | dcp | pruning)
            install_context_pruning
            ;;
          memory | mem)
            install_memory
            ;;
          *)
            die "unknown add-on: ${target} (agent-skills|graphify|context-pruning|memory|all)"
            ;;
        esac
      done
      info "add-ons installed. Start a new OpenCode session to load new skills/plugins."
      ;;
    *)
      die "usage: openweb addons [status|install [agent-skills|graphify|context-pruning|memory|all]]"
      ;;
  esac
}

cmd_status() {
  require_root
  load_config

  systemctl --no-pager --full status "$SERVICE_NAME" || true
  printf '\n'

  if systemctl is-active --quiet "$SERVICE_NAME"; then
    info "service is running"
  else
    warn "service is not running"
  fi
  if use_nginx; then
    if systemctl is-active --quiet nginx; then
      info "nginx is running"
    else
      warn "nginx is not running"
    fi
  fi

  PASSWORD=$(cat "$PASSWORD_FILE" 2>/dev/null || true)
  print_summary
}

cmd_logs() {
  require_root
  local units=(-u "$SERVICE_NAME")
  if [[ -f $CONFIG_FILE ]]; then
    local ui_mode tls_mode
    ui_mode=$(config_value UI_MODE)
    tls_mode=$(config_value TLS_MODE)
    if [[ $ui_mode == modified || ${tls_mode:-http} != http ]]; then
      units+=(-u nginx)
    fi
  fi
  journalctl "${units[@]}" -f --no-pager
}

cmd_password() {
  require_root
  load_config
  prompt_password

  ( umask 077; printf '%s' "$PASSWORD" > "$PASSWORD_FILE" )
  chown "root:${SERVICE_GROUP}" "$PASSWORD_FILE"
  chmod 0640 "$PASSWORD_FILE"

  systemctl restart "$SERVICE_NAME"

  if health_check; then
    info "password updated"
    print_summary
  else
    die "password changed but the service did not become healthy; check 'openweb logs'"
  fi
}

cmd_uninstall() {
  require_root
  local nginx_flag=0 tls_mode=""
  if [[ -f $CONFIG_FILE ]]; then
    nginx_flag=$(config_value NGINX_INSTALLED_BY_OPENWEB)
    nginx_flag=${nginx_flag:-0}
    tls_mode=$(config_value TLS_MODE)
  fi

  if ! confirm "Stop and remove OpenCode Web? The OpenCode CLI and session data will be kept."; then
    info "aborted"
    return 0
  fi

  info "removing OpenCode Web"
  systemctl disable --now "$SERVICE_NAME" >/dev/null 2>&1 || true
  remove_nginx
  rm -f "$UNIT_FILE"
  rm -f "$CERTBOT_DEPLOY_HOOK"
  systemctl daemon-reload
  rm -rf "$CONFIG_DIR" "$RUNNER_DIR"
  rm -f "$MANAGER_BIN"

  info "OpenCode Web has been removed"
  printf '  %sThe OpenCode CLI and session data were kept.%s\n' "$C_DIM" "$C_RESET"
  if [[ ${tls_mode:-http} != http ]]; then
    printf '  %sThe TLS certificate was kept under /etc/letsencrypt (if Let'"'"'s Encrypt was used).%s\n' "$C_DIM" "$C_RESET"
  fi
  if [[ $nginx_flag == 1 ]]; then
    printf '  %snginx was installed by openweb and has been left in place.%s\n' "$C_DIM" "$C_RESET"
  fi
}

pause() {
  [[ -r /dev/tty ]] || return 0
  printf '\nPress Enter to continue... ' >/dev/tty
  IFS= read -r _ < /dev/tty || true
}

main_menu() {
  local answer
  while true; do
    printf '\n%s================= OpenCode Web =================%s\n' "$C_CYAN" "$C_RESET" >/dev/tty
    printf '%s Control panel%s\n\n' "$C_BOLD" "$C_RESET" >/dev/tty
    printf '  %s1)%s Install / reinstall\n' "$C_BOLD" "$C_RESET" >/dev/tty
    if [[ -f $CONFIG_FILE ]]; then
      printf '  %s2)%s Features (enable / disable)\n' "$C_BOLD" "$C_RESET" >/dev/tty
      printf '  %s3)%s Status\n' "$C_BOLD" "$C_RESET" >/dev/tty
      printf '  %s4)%s Change password\n' "$C_BOLD" "$C_RESET" >/dev/tty
      printf '  %s5)%s Update\n' "$C_BOLD" "$C_RESET" >/dev/tty
      printf '  %s6)%s Logs\n' "$C_BOLD" "$C_RESET" >/dev/tty
      printf '  %s7)%s Uninstall\n' "$C_BOLD" "$C_RESET" >/dev/tty
      printf '  %s8)%s Agent add-ons (skills, graphify, memory)\n' "$C_BOLD" "$C_RESET" >/dev/tty
    else
      printf '  %s2)%s Help\n' "$C_BOLD" "$C_RESET" >/dev/tty
    fi
    printf '  %s0)%s Exit\n' "$C_BOLD" "$C_RESET" >/dev/tty
    printf '\nSelect: ' >/dev/tty
    IFS= read -r answer < /dev/tty || return 0

    case $answer in
      1) cmd_install; pause ;;
      2)
        if [[ -f $CONFIG_FILE ]]; then
          cmd_features
        else
          usage
        fi
        pause
        ;;
      3)
        if [[ -f $CONFIG_FILE ]]; then cmd_status; else warn "not installed"; fi
        pause
        ;;
      4)
        if [[ -f $CONFIG_FILE ]]; then cmd_password; else warn "not installed"; fi
        pause
        ;;
      5)
        if [[ -f $CONFIG_FILE ]]; then cmd_update; else warn "not installed"; fi
        pause
        ;;
      6)
        if [[ -f $CONFIG_FILE ]]; then cmd_logs; else warn "not installed"; fi
        pause
        ;;
      7)
        if [[ -f $CONFIG_FILE ]]; then cmd_uninstall; else warn "not installed"; fi
        pause
        ;;
      8)
        if [[ -f $CONFIG_FILE ]]; then cmd_addons install; else warn "not installed"; fi
        pause
        ;;
      0 | q | exit | quit)
        return 0
        ;;
      *)
        warn "invalid selection: ${answer}"
        ;;
    esac
  done
}

main() {
  local command=""
  local extras=()
  local command_set=0

  while (($# > 0)); do
    case $1 in
      install | update | features | status | logs | password | uninstall | version | help | addons | on | off)
        if (( command_set == 0 )); then
          command=$1
          command_set=1
        else
          extras+=("$1")
        fi
        shift
        ;;
      -p | --port)
        [[ $# -ge 2 ]] || die "missing value for $1"
        LISTEN_PORT=$2
        OPT_PORT=$2
        shift 2
        ;;
      -H | --hostname)
        [[ $# -ge 2 ]] || die "missing value for $1"
        LISTEN_HOST=$2
        OPT_HOST=$2
        shift 2
        ;;
      -u | --user)
        [[ $# -ge 2 ]] || die "missing value for $1"
        SERVICE_USER=$2
        OPT_USER=$2
        shift 2
        ;;
      -U | --username)
        [[ $# -ge 2 ]] || die "missing value for $1"
        AUTH_USER=$2
        OPT_AUTH_USER=$2
        shift 2
        ;;
      --password)
        [[ $# -ge 2 ]] || die "missing value for $1"
        PASSWORD=$2
        shift 2
        ;;
      --original)
        UI_MODE=original
        OPT_UI_MODE=original
        shift
        ;;
      --modified)
        UI_MODE=modified
        OPT_UI_MODE=modified
        shift
        ;;
      --web)
        [[ $# -ge 2 ]] || die "missing value for $1"
        OPT_WEB=$2
        shift 2
        ;;
      --web-v2)
        OPT_WEB=v2
        shift
        ;;
      --web-v1)
        OPT_WEB=v1
        shift
        ;;
      --features)
        [[ $# -ge 2 ]] || die "missing value for $1"
        OPT_FEATURES=$2
        OPT_FEATURES_SET=1
        shift 2
        ;;
      --domain)
        [[ $# -ge 2 ]] || die "missing value for $1"
        OPT_DOMAIN=$2
        shift 2
        ;;
      --tls)
        [[ $# -ge 2 ]] || die "missing value for $1"
        OPT_TLS=$2
        shift 2
        ;;
      --email)
        [[ $# -ge 2 ]] || die "missing value for $1"
        OPT_EMAIL=$2
        shift 2
        ;;
      --tls-cert)
        [[ $# -ge 2 ]] || die "missing value for $1"
        OPT_TLS_CERT=$2
        shift 2
        ;;
      --tls-key)
        [[ $# -ge 2 ]] || die "missing value for $1"
        OPT_TLS_KEY=$2
        shift 2
        ;;
      --https-port)
        [[ $# -ge 2 ]] || die "missing value for $1"
        OPT_HTTPS_PORT=$2
        shift 2
        ;;
      --letsencrypt | --nip-io)
        OPT_TLS=letsencrypt
        shift
        ;;
      --no-tls | --http-only)
        OPT_TLS=http
        shift
        ;;
      --reuse)
        REUSE=1
        shift
        ;;
      -y | --yes)
        ASSUME_YES=1
        shift
        ;;
      --no-color)
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      -V | --version)
        printf '%s\n' "$SCRIPT_VERSION"
        exit 0
        ;;
      -*)
        die "unknown option: $1 (use --help)"
        ;;
      *)
        if (( command_set == 0 )); then
          command=$1
          command_set=1
        else
          extras+=("$1")
        fi
        shift
        ;;
    esac
  done

  if [[ -z $command ]]; then
    if is_interactive; then
      main_menu
      return 0
    fi
    command="install"
  fi

  case $command in
    install | update | status | logs | password | uninstall)
      ((${#extras[@]} == 0)) || die "unexpected argument for ${command}: ${extras[0]}"
      ;;
  esac

  case $command in
    install) cmd_install ;;
    update) cmd_update ;;
    features) cmd_features "${extras[@]}" ;;
    addons) cmd_addons "${extras[@]}" ;;
    on | off) cmd_features "$command" "${extras[@]}" ;;
    status) cmd_status ;;
    logs) cmd_logs ;;
    password) cmd_password ;;
    uninstall) cmd_uninstall ;;
    version) printf '%s\n' "$SCRIPT_VERSION" ;;
    help) usage ;;
    *) die "unknown command: ${command} (use --help)" ;;
  esac
}

main "$@"
