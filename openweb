#!/usr/bin/env bash
#
# openweb - install and manage OpenCode Web on Linux servers (systemd).
# Repository: https://github.com/Aknuun/openweb
#
set -Eeuo pipefail

readonly SCRIPT_NAME="openweb"
readonly SCRIPT_VERSION="1.0.0"
readonly REPO_URL="https://github.com/Aknuun/openweb"
readonly SERVICE_NAME="openweb"
readonly UNIT_FILE="/etc/systemd/system/${SERVICE_NAME}.service"
readonly CONFIG_DIR="/etc/openweb"
readonly CONFIG_FILE="${CONFIG_DIR}/config"
readonly PASSWORD_FILE="${CONFIG_DIR}/password"
readonly RUNNER_DIR="/usr/local/lib/openweb"
readonly RUNNER_FILE="${RUNNER_DIR}/run"
readonly MANAGER_BIN="/usr/local/bin/openweb"

for _arg in "$@"; do
  if [[ $_arg == "--no-color" ]]; then
    NO_COLOR=1
  fi
done

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_RESET=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_RED=$'\033[1;31m'
  C_GREEN=$'\033[1;32m'
  C_YELLOW=$'\033[1;33m'
  C_BLUE=$'\033[1;34m'
  C_MAGENTA=$'\033[1;35m'
  C_CYAN=$'\033[1;36m'
else
  C_RESET=""
  C_BOLD=""
  C_DIM=""
  C_RED=""
  C_GREEN=""
  C_YELLOW=""
  C_BLUE=""
  C_MAGENTA=""
  C_CYAN=""
fi

SERVICE_USER="root"
AUTH_USER="opencode"
LISTEN_HOST="0.0.0.0"
LISTEN_PORT="5002"
PASSWORD="${OPENWEB_PASSWORD:-}"
ASSUME_YES=0

SERVICE_GROUP=""
SERVICE_HOME=""
OPENCODE_BIN=""

info() { printf '%s==>%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
step() { printf '  %s-%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }
warn() { printf '%swarn:%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
error() { printf '%serror:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
die() {
  error "$*"
  exit 1
}

have() { command -v "$1" >/dev/null 2>&1; }
need() { have "$1" || die "missing dependency: $1"; }

usage() {
  cat <<EOF
${C_BOLD}openweb${C_RESET} ${C_DIM}v${SCRIPT_VERSION}${C_RESET} - install and manage OpenCode Web

${C_BOLD}Usage${C_RESET}
  sudo openweb [command] [options]

${C_BOLD}Commands${C_RESET}
  install       Install/update OpenCode Web and enable it (default)
  status        Show service status, URL and credentials
  logs          Follow the service logs
  password      Change the web password and restart the service
  uninstall     Stop, disable and remove OpenCode Web
  version       Print the script version
  help          Show this help

${C_BOLD}Options${C_RESET}
  -p, --port <port>         Port to listen on (default: 5002)
  -H, --hostname <addr>     Address to bind (default: 0.0.0.0)
  -u, --user <name>         Linux user that runs the service (default: root)
  -U, --username <name>     Web login username (default: opencode)
      --password <value>    Web login password (prompted if omitted)
  -y, --yes                 Do not ask for confirmation
      --no-color            Disable colored output
  -h, --help                Show this help
  -V, --version             Print the script version

${C_BOLD}Environment${C_RESET}
  OPENWEB_PASSWORD          Non-interactive password (the prompt is preferred)

${C_BOLD}Examples${C_RESET}
  sudo openweb
  sudo openweb install --port 8080 --username admin
  sudo openweb status
  sudo openweb password
  sudo openweb uninstall

Repository: ${REPO_URL}
EOF
}

require_root() {
  [[ $EUID -eq 0 ]] || die "run as root (sudo)"
}

validate_port() {
  [[ $LISTEN_PORT =~ ^[0-9]+$ ]] || die "invalid port: $LISTEN_PORT"
  (( LISTEN_PORT >= 1 && LISTEN_PORT <= 65535 )) || die "port must be between 1 and 65535"
}

validate_settings() {
  validate_port
  [[ $LISTEN_HOST =~ ^[A-Za-z0-9._:-]+$ ]] || die "invalid hostname: $LISTEN_HOST"
  [[ $AUTH_USER =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid username: $AUTH_USER"
  id "$SERVICE_USER" >/dev/null 2>&1 || die "user does not exist: $SERVICE_USER"

  SERVICE_GROUP=$(id -gn "$SERVICE_USER")
  SERVICE_HOME=$(getent passwd "$SERVICE_USER" | cut -d: -f6)
  [[ -n $SERVICE_HOME && -d $SERVICE_HOME ]] || die "cannot determine home directory for $SERVICE_USER"
  [[ $SERVICE_HOME != *[[:space:]]* ]] || die "home directory must not contain whitespace: $SERVICE_HOME"
}

confirm() {
  (( ASSUME_YES == 1 )) && return 0
  [[ -r /dev/tty ]] || return 1

  local answer
  printf '%s?%s %s [y/N] ' "$C_YELLOW" "$C_RESET" "$1" >/dev/tty
  IFS= read -r answer < /dev/tty || return 1
  [[ $answer =~ ^[Yy]$ ]]
}

prompt_password() {
  if [[ -n $PASSWORD ]]; then
    [[ $PASSWORD != *$'\n'* ]] || die "password must not contain newlines"
    (( ${#PASSWORD} >= 8 )) || die "password must be at least 8 characters"
    return 0
  fi

  [[ -r /dev/tty ]] || die "no terminal for the password prompt; use --password or OPENWEB_PASSWORD"

  local first second
  while true; do
    printf '%sChoose a password for %s (min 8 characters):%s ' "$C_BOLD" "$AUTH_USER" "$C_RESET" >/dev/tty
    IFS= read -rs first < /dev/tty || die "failed to read password"
    printf '\n' >/dev/tty

    if (( ${#first} < 8 )); then
      warn "password must be at least 8 characters"
      continue
    fi

    printf '%sConfirm password:%s ' "$C_BOLD" "$C_RESET" >/dev/tty
    IFS= read -rs second < /dev/tty || die "failed to read password"
    printf '\n' >/dev/tty

    if [[ $first != "$second" ]]; then
      warn "passwords do not match"
      continue
    fi

    PASSWORD=$first
    return 0
  done
}

find_opencode() {
  local candidate
  for candidate in "${SERVICE_HOME}/.opencode/bin/opencode" /usr/local/bin/opencode /usr/bin/opencode; do
    if [[ -x $candidate ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  candidate=$(command -v opencode 2>/dev/null || true)
  if [[ -n $candidate && -x $candidate ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  return 1
}

install_opencode() {
  need curl
  info "OpenCode CLI was not found; installing it for ${SERVICE_USER}"

  local tmp
  tmp=$(mktemp)
  if ! curl -fsSL --retry 3 https://opencode.ai/install -o "$tmp"; then
    rm -f "$tmp"
    die "failed to download the OpenCode installer"
  fi

  if ! HOME="$SERVICE_HOME" bash "$tmp" --no-modify-path >&2; then
    rm -f "$tmp"
    die "OpenCode installation failed"
  fi
  rm -f "$tmp"

  OPENCODE_BIN="${SERVICE_HOME}/.opencode/bin/opencode"
  [[ -x $OPENCODE_BIN ]] || die "OpenCode was installed but the binary was not found"

  if [[ $SERVICE_USER != root ]]; then
    chown -R "${SERVICE_USER}:${SERVICE_GROUP}" "${SERVICE_HOME}/.opencode" 2>/dev/null || true
  fi
}

check_port_free() {
  have ss || return 0
  if ss -ltn 2>/dev/null | awk 'NR > 1 { print $4 }' | grep -qE "[:.]${LISTEN_PORT}$"; then
    die "port ${LISTEN_PORT} is already in use"
  fi
}

write_config() {
  cat > "$CONFIG_FILE" <<EOF
# Generated by openweb v${SCRIPT_VERSION}
SERVICE_USER=${SERVICE_USER}
SERVICE_GROUP=${SERVICE_GROUP}
AUTH_USER=${AUTH_USER}
LISTEN_HOST=${LISTEN_HOST}
LISTEN_PORT=${LISTEN_PORT}
OPENCODE_BIN=${OPENCODE_BIN}
INSTALLED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
  chmod 0644 "$CONFIG_FILE"
}

write_runner() {
  cat > "$RUNNER_FILE" <<EOF
#!/bin/sh
set -eu
OPENCODE_SERVER_USERNAME="${AUTH_USER}"
OPENCODE_SERVER_PASSWORD="\$(cat "${PASSWORD_FILE}")"
export OPENCODE_SERVER_USERNAME OPENCODE_SERVER_PASSWORD
exec "${OPENCODE_BIN}" web --hostname "${LISTEN_HOST}" --port "${LISTEN_PORT}"
EOF
  chmod 0755 "$RUNNER_FILE"
}

write_unit() {
  cat > "$UNIT_FILE" <<EOF
[Unit]
Description=OpenCode Web (${SCRIPT_NAME})
Documentation=${REPO_URL}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${SERVICE_USER}
Group=${SERVICE_GROUP}
Environment="HOME=${SERVICE_HOME}"
WorkingDirectory=${SERVICE_HOME}
ExecStart=${RUNNER_FILE}
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
EOF
  chmod 0644 "$UNIT_FILE"
}

local_url() {
  local host=127.0.0.1
  case $LISTEN_HOST in
    0.0.0.0 | :: | '*') ;;
    *) host=$LISTEN_HOST ;;
  esac
  [[ $host == *:* ]] && host="[$host]"
  printf 'http://%s:%s/' "$host" "$LISTEN_PORT"
}

public_url() {
  local host=$LISTEN_HOST
  case $host in
    0.0.0.0 | :: | '*')
      host=$(hostname -I 2>/dev/null | awk '{ print $1 }')
      [[ -n $host ]] || host=127.0.0.1
      ;;
  esac
  [[ $host == *:* ]] && host="[$host]"
  printf 'http://%s:%s/' "$host" "$LISTEN_PORT"
}

health_url() {
  local host=127.0.0.1
  case $LISTEN_HOST in
    0.0.0.0 | :: | '*') ;;
    *) host=$LISTEN_HOST ;;
  esac
  [[ $host == *:* ]] && host="[$host]"
  printf 'http://%s:%s/' "$host" "$LISTEN_PORT"
}

health_check() {
  local attempt code
  for ((attempt = 1; attempt <= 30; attempt++)); do
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 \
      -u "${AUTH_USER}:${PASSWORD}" "$(health_url)" || true)
    case $code in
      200 | 204 | 301 | 302 | 303 | 307 | 308) return 0 ;;
    esac
    sleep 1
  done
  return 1
}

print_summary() {
  local remote_url local_url_value
  remote_url=$(public_url)
  local_url_value=$(local_url)

  printf '\n'
  printf '%s================================================================%s\n' "$C_CYAN" "$C_RESET"
  printf '%s  OpenCode Web is installed and running%s\n' "$C_BOLD$C_GREEN" "$C_RESET"
  printf '%s================================================================%s\n' "$C_CYAN" "$C_RESET"
  printf '  %sURL%s          %s%s%s\n' "$C_BOLD" "$C_RESET" "$C_GREEN" "$remote_url" "$C_RESET"
  if [[ $local_url_value != "$remote_url" ]]; then
    printf '  %sLocal URL%s    %s%s%s\n' "$C_BOLD" "$C_RESET" "$C_DIM" "$local_url_value" "$C_RESET"
  fi
  printf '  %sUsername%s     %s%s%s\n' "$C_BOLD" "$C_RESET" "$C_YELLOW" "$AUTH_USER" "$C_RESET"
  printf '  %sPassword%s     %s%s%s\n' "$C_BOLD" "$C_RESET" "$C_MAGENTA" "$PASSWORD" "$C_RESET"
  printf '  %sPort%s         %s\n' "$C_BOLD" "$C_RESET" "$LISTEN_PORT"
  printf '  %sService%s      %s%s%s\n' "$C_BOLD" "$C_RESET" "$C_BLUE" "$SERVICE_NAME" "$C_RESET"
  printf '  %sConfig%s       %s\n' "$C_BOLD" "$C_RESET" "$CONFIG_DIR"
  printf '\n  %sManage%s\n' "$C_BOLD" "$C_RESET"
  printf '    sudo openweb status\n'
  printf '    sudo openweb logs\n'
  printf '    sudo openweb password\n'
  printf '    sudo openweb uninstall\n'
  printf '\n  %sKeep these credentials somewhere safe.%s\n' "$C_YELLOW" "$C_RESET"

  if [[ $LISTEN_HOST == 0.0.0.0 || $LISTEN_HOST == '::' || $LISTEN_HOST == '*' ]]; then
    printf '  %sSecurity:%s the service is exposed over plain HTTP. Put it behind a TLS reverse proxy before exposing it to the internet.\n' "$C_RED" "$C_RESET"
    printf '  %sFirewall:%s if a firewall is enabled, allow TCP %s (for example: sudo ufw allow %s/tcp).\n' "$C_RED" "$C_RESET" "$LISTEN_PORT" "$LISTEN_PORT"
  fi

  printf '%s================================================================%s\n\n' "$C_CYAN" "$C_RESET"
}

install_manager() {
  local source=${BASH_SOURCE[0]:-}
  if [[ -n $source && -f $source ]]; then
    install -m 0755 "$source" "$MANAGER_BIN"
  else
    warn "running from stdin; the 'openweb' command was not installed to ${MANAGER_BIN}"
  fi
}

load_config() {
  [[ -f $CONFIG_FILE ]] || die "OpenCode Web is not installed (missing ${CONFIG_FILE})"
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  SERVICE_HOME=$(getent passwd "$SERVICE_USER" | cut -d: -f6)
}

cmd_install() {
  require_root
  need systemctl
  need curl
  validate_settings

  if [[ -f $UNIT_FILE ]]; then
    if ! confirm "OpenCode Web is already installed. Reinstall/update it?"; then
      info "aborted"
      return 0
    fi
    systemctl stop "$SERVICE_NAME" 2>/dev/null || true
  fi

  prompt_password

  OPENCODE_BIN=$(find_opencode || true)
  if [[ -z $OPENCODE_BIN ]]; then
    install_opencode
  fi
  [[ -x $OPENCODE_BIN ]] || die "OpenCode binary is not executable: $OPENCODE_BIN"
  case $OPENCODE_BIN in
    *[\"\$\`\\]* | *$'\n'*) die "unsupported character in OpenCode path: $OPENCODE_BIN" ;;
  esac

  check_port_free

  info "installing OpenCode Web"
  mkdir -p "$CONFIG_DIR" "$RUNNER_DIR"
  chmod 0755 "$CONFIG_DIR" "$RUNNER_DIR"

  ( umask 077; printf '%s' "$PASSWORD" > "$PASSWORD_FILE" )
  chown "root:${SERVICE_GROUP}" "$PASSWORD_FILE"
  chmod 0640 "$PASSWORD_FILE"

  step "writing configuration"
  write_config
  write_runner
  write_unit

  step "enabling the systemd service"
  systemctl daemon-reload
  systemctl enable "$SERVICE_NAME" >/dev/null
  systemctl restart "$SERVICE_NAME"

  step "waiting for the web interface"
  if ! health_check; then
    error "the service did not become healthy"
    journalctl -u "$SERVICE_NAME" -n 40 --no-pager >&2 || true
    die "installation failed; check the logs and run 'openweb install' again"
  fi

  install_manager
  print_summary
}

cmd_status() {
  require_root
  load_config

  systemctl --no-pager --full status "$SERVICE_NAME" || true
  printf '\n'

  if systemctl is-active --quiet "$SERVICE_NAME"; then
    info "service is running"
  else
    warn "service is not running"
  fi

  PASSWORD=$(cat "$PASSWORD_FILE" 2>/dev/null || true)
  print_summary
}

cmd_logs() {
  require_root
  journalctl -u "$SERVICE_NAME" -f --no-pager
}

cmd_password() {
  require_root
  load_config
  prompt_password

  ( umask 077; printf '%s' "$PASSWORD" > "$PASSWORD_FILE" )
  chown "root:${SERVICE_GROUP}" "$PASSWORD_FILE"
  chmod 0640 "$PASSWORD_FILE"

  systemctl restart "$SERVICE_NAME"

  if health_check; then
    info "password updated"
    print_summary
  else
    die "password changed but the service did not become healthy; check 'openweb logs'"
  fi
}

cmd_uninstall() {
  require_root

  if ! confirm "Stop and remove OpenCode Web? The OpenCode CLI and session data will be kept."; then
    info "aborted"
    return 0
  fi

  info "removing OpenCode Web"
  systemctl disable --now "$SERVICE_NAME" >/dev/null 2>&1 || true
  rm -f "$UNIT_FILE"
  systemctl daemon-reload
  rm -rf "$CONFIG_DIR" "$RUNNER_DIR"
  rm -f "$MANAGER_BIN"

  info "OpenCode Web has been removed"
  printf '  %sThe OpenCode CLI and session data were kept.%s\n' "$C_DIM" "$C_RESET"
}

main() {
  local command="install"

  while (($# > 0)); do
    case $1 in
      install | status | logs | password | uninstall | version | help)
        command=$1
        shift
        ;;
      -p | --port)
        [[ $# -ge 2 ]] || die "missing value for $1"
        LISTEN_PORT=$2
        shift 2
        ;;
      -H | --hostname)
        [[ $# -ge 2 ]] || die "missing value for $1"
        LISTEN_HOST=$2
        shift 2
        ;;
      -u | --user)
        [[ $# -ge 2 ]] || die "missing value for $1"
        SERVICE_USER=$2
        shift 2
        ;;
      -U | --username)
        [[ $# -ge 2 ]] || die "missing value for $1"
        AUTH_USER=$2
        shift 2
        ;;
      --password)
        [[ $# -ge 2 ]] || die "missing value for $1"
        PASSWORD=$2
        shift 2
        ;;
      -y | --yes)
        ASSUME_YES=1
        shift
        ;;
      --no-color)
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      -V | --version)
        printf '%s\n' "$SCRIPT_VERSION"
        exit 0
        ;;
      *)
        die "unknown option or command: $1 (use --help)"
        ;;
    esac
  done

  case $command in
    install) cmd_install ;;
    status) cmd_status ;;
    logs) cmd_logs ;;
    password) cmd_password ;;
    uninstall) cmd_uninstall ;;
    version) printf '%s\n' "$SCRIPT_VERSION" ;;
    help) usage ;;
  esac
}

main "$@"
